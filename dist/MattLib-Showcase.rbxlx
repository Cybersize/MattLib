__modules["styling/Tokens"] = function(__require)
--!nonstrict
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local shared = {
	spacing = { none = 0, xs = 4, sm = 8, md = 12, lg = 16, xl = 24, xxl = 32 },
	radius = { sm = 4, md = 7, lg = 11, pill = 999 },
	typography = { font = Enum.Font.BuilderSans, medium = Enum.Font.BuilderSansMedium,
		bold = Enum.Font.BuilderSansBold, small = 12, body = 14, title = 18, display = 26 },
	motion = { fast = 0.12, normal = 0.18, slow = 0.24 },
	controlHeight = 38,
}
local Tokens = {}
Tokens.Dark = {
	background = rgb(17, 19, 25), surface = rgb(24, 27, 35), raised = rgb(31, 35, 45),
	input = rgb(20, 23, 30), border = rgb(48, 54, 68), accent = rgb(132, 153, 255),
	accentHover = rgb(153, 171, 255), accentPressed = rgb(109, 130, 232),
	accentText = rgb(15, 21, 42), hover = rgb(40, 45, 58), pressed = rgb(48, 54, 69),
	text = rgb(232, 236, 245), muted = rgb(154, 165, 185), subtle = rgb(113, 125, 148),
	disabled = rgb(82, 92, 112), danger = rgb(249, 119, 133), success = rgb(104, 210, 166),
	warning = rgb(239, 191, 104), overlay = rgb(3, 5, 12),
}
Tokens.Light = {
	background = rgb(242, 244, 249), surface = rgb(255, 255, 255), raised = rgb(234, 238, 246),
	input = rgb(247, 249, 252), border = rgb(211, 218, 230), accent = rgb(77, 94, 205),
	accentHover = rgb(63, 80, 188), accentPressed = rgb(50, 65, 164),
	accentText = rgb(255, 255, 255), hover = rgb(229, 234, 245), pressed = rgb(218, 225, 239),
	text = rgb(28, 34, 49), muted = rgb(90, 104, 128), subtle = rgb(114, 125, 147),
	disabled = rgb(151, 160, 177), danger = rgb(185, 47, 69), success = rgb(26, 125, 87),
	warning = rgb(151, 99, 17), overlay = rgb(12, 17, 29),
}
for _, theme in { Tokens.Dark, Tokens.Light } do
	for key, value in shared do theme[key] = value end
end
return Tokens

end
-- END styling/Tokens

-- BEGIN styling/Theme
__modules["styling/Theme"] = function(__require)
--!nonstrict
local Signal = __require("core/Signal")
local Tokens = __require("styling/Tokens")
local Theme = {}
Theme.__index = Theme
local function copy(value,depth,seen)
	if typeof(value) ~= "table" then return value end
	depth,seen=depth or 0,seen or {}
	assert(depth&lt;=16 and not seen[value],"Theme tokens must be acyclic tables under 16 levels")
	seen[value]=true
	local output = {}
	for key, child in value do output[key] = copy(child,depth+1,seen) end
	seen[value]=nil
	return output
end
local function validate(value,expected,path)
	assert(typeof(value)==typeof(expected),"Invalid theme token: "..path)
	if typeof(expected)=="table" then
		for key,child in expected do validate(value[key],child,path.."."..key) end
	elseif type(expected)=="number" then
		assert(value==value and value&gt;=0 and value&lt;math.huge,"Theme numeric tokens must be finite and nonnegative: "..path)
	elseif typeof(expected)=="EnumItem" then
		assert(value.EnumType==expected.EnumType,"Invalid enum token: "..path)
	end
end
local function merge(base, overrides)
	local result = copy(base)
	for key, value in overrides or {} do
		if typeof(value) == "table" and typeof(result[key]) == "table" then result[key] = merge(result[key], value)
		else result[key] = copy(value) end
	end
	return result
end
local function freeze(value)
	if typeof(value) == "table" and not table.isfrozen(value) then
		for _, child in value do freeze(child) end
		table.freeze(value)
	end
	return value
end
function Theme.resolve(theme)
	if type(theme) == "string" then
		assert(Tokens[theme], "Unknown theme " .. theme)
		return freeze(copy(Tokens[theme]))
	end
	assert(type(theme) == "table", "Theme must be Dark, Light, or a token table")
	local resolved = merge(Tokens.Dark, theme)
	for key, expected in Tokens.Dark do validate(resolved[key],expected,key) end
	return freeze(resolved)
end
function Theme.new(theme)
	return setmetatable({ signal = Signal.new(Theme.resolve(theme or "Dark")) }, Theme)
end
function Theme:Set(theme) self.signal:set(Theme.resolve(theme)) end
function Theme:Get() return self.signal:get() end
function Theme:Extend(overrides) self:Set(merge(self:Get(), overrides)) end
function Theme:Destroy() self.signal:Destroy() end
function Theme.token(theme, value)
	if type(value) ~= "string" or string.sub(value, 1, 1) ~= "$" then return value end
	local result = theme
	for segment in string.gmatch(string.sub(value, 2), "[^.]+") do
		assert(type(result) == "table" and result[segment] ~= nil, "Unknown theme token " .. value)
		result = result[segment]
	end
	return result
end
Theme.merge = merge
return Theme

end
-- END styling/Theme

-- BEGIN styling/StyleResolver
__modules["styling/StyleResolver"] = function(__require)
--!nonstrict
local Theme = __require("styling/Theme")
local Style = {}
local valid = {}
for _, name in { "background", "backgroundTransparency", "color", "font", "textSize", "textAlign", "textYAlign",
	"wrapped", "richText", "width", "height", "position", "anchor", "minWidth", "minHeight", "maxWidth", "maxHeight",
	"padding", "paddingX", "paddingY", "borderColor", "borderWidth", "radius", "opacity", "direction", "gap",
	"horizontalAlign", "verticalAlign", "distribute", "wrap", "grow", "shrink", "visible", "overflow", "zIndex",
	"rotation", "hover", "pressed", "focus", "active", "disabled", "imageColor", "imageTransparency", "scrollbarColor",
} do valid[name] = true end
local function dim(value)
	if typeof(value) == "UDim" then return value end
	if type(value) == "number" then return UDim.new(0, value) end
	if type(value) == "string" then
		local percent = string.match(value, "^([%d%.]+)%%$")
		if percent then return UDim.new(tonumber(percent) / 100, 0) end
	end
	error("Dimensions must be pixels, UDim, percentages, or 'auto'", 3)
end
local function enum(mapping, value, property)
	assert(mapping[value], "Invalid " .. property .. ": " .. tostring(value))
	return mapping[value]
end
function Style.merge(...)
	local result = {}
	for index = 1, select("#", ...) do
		local style = select(index, ...)
		for key, value in style or {} do
			if typeof(value) == "table" and typeof(result[key]) == "table" then
				result[key] = Style.merge(result[key], value)
			else result[key] = value end
		end
	end
	return result
end
function Style.resolve(source, theme, state, className)
	local style = {}
	for key, value in source or {} do
		assert(valid[key], "Unsupported style property: " .. tostring(key) .. ". Use parent gap/padding or Inset for spacing.")
		if key ~= "hover" and key ~= "pressed" and key ~= "focus" and key ~= "active" and key ~= "disabled" then style[key] = value end
	end
	for _, key in { "active", "hover", "pressed", "focus", "disabled" } do
		if state[key] then
			for name, value in (source or {})[key] or {} do
				assert(valid[name], "Unsupported state style: " .. tostring(name))
				style[name] = value
			end
		end
	end
	for key, value in style do style[key] = Theme.token(theme, value) end
	local props, decorations = {}, {}
	local text = className == "TextLabel" or className == "TextButton" or className == "TextBox"
	local image = className == "ImageLabel" or className == "ImageButton"
	if style.background then props.BackgroundColor3 = style.background end
	if style.backgroundTransparency ~= nil then props.BackgroundTransparency = style.backgroundTransparency end
	if text then
		if style.color then props.TextColor3 = style.color end
		if style.font then props.Font = style.font end
		if style.textSize then props.TextSize = style.textSize end
		if style.wrapped ~= nil then props.TextWrapped = style.wrapped end
		if style.richText ~= nil then props.RichText = style.richText end
		if style.textAlign then props.TextXAlignment = enum({left=Enum.TextXAlignment.Left, center=Enum.TextXAlignment.Center, right=Enum.TextXAlignment.Right}, style.textAlign, "textAlign") end
		if style.textYAlign then props.TextYAlignment = enum({top=Enum.TextYAlignment.Top, center=Enum.TextYAlignment.Center, bottom=Enum.TextYAlignment.Bottom}, style.textYAlign, "textYAlign") end
	end
	if image then
		if style.imageColor then props.ImageColor3 = style.imageColor end
		if style.imageTransparency ~= nil then props.ImageTransparency = style.imageTransparency end
	end
	if style.opacity ~= nil then
		assert(type(style.opacity) == "number" and style.opacity &gt;= 0 and style.opacity &lt;= 1, "Opacity must be 0..1")
		if className == "CanvasGroup" then props.GroupTransparency = 1 - style.opacity
		else
			props.BackgroundTransparency = 1 - style.opacity * (1 - (props.BackgroundTransparency or 0))
			if text then props.TextTransparency = 1 - style.opacity end
			if image then props.ImageTransparency = 1 - style.opacity end
		end
	end
	if style.width ~= nil or style.height ~= nil then
		local w, h = style.width or "100%", style.height or "auto"
		local aw, ah = w == "auto", h == "auto"
		local x, y = if aw then UDim.new() else dim(w), if ah then UDim.new() else dim(h)
		props.Size = UDim2.new(x.Scale, x.Offset, y.Scale, y.Offset)
		props.AutomaticSize = if aw and ah then Enum.AutomaticSize.XY elseif aw then Enum.AutomaticSize.X elseif ah then Enum.AutomaticSize.Y else Enum.AutomaticSize.None
	end
	if style.position then props.Position = style.position end
	if style.anchor then props.AnchorPoint = style.anchor end
	if style.visible ~= nil then props.Visible = style.visible end
	if style.zIndex then props.ZIndex = style.zIndex end
	if style.rotation then props.Rotation = style.rotation end
	if style.overflow then
		assert(style.overflow == "hidden" or style.overflow == "visible" or style.overflow == "scroll", "Invalid overflow")
		assert(style.overflow ~= "scroll" or className == "ScrollingFrame", "Use ScrollArea for scrolling")
		props.ClipsDescendants = style.overflow ~= "visible"
	end
	if className == "ScrollingFrame" and style.scrollbarColor then props.ScrollBarImageColor3 = style.scrollbarColor end
	if style.radius then decorations.corner = { class = "UICorner", CornerRadius = UDim.new(0, style.radius) } end
	if style.borderWidth and style.borderWidth &gt; 0 then
		decorations.stroke = { class = "UIStroke", Thickness = style.borderWidth, Color = style.borderColor or theme.border,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
	end
	if style.padding ~= nil or style.paddingX ~= nil or style.paddingY ~= nil then
		local padding = style.padding or 0
		local t, r, b, l
		if type(padding) == "table" then
			t, r, b, l = padding[1] or 0, padding[2] or 0, padding[3] or padding[1] or 0, padding[4] or padding[2] or 0
		else t, r, b, l = padding, padding, padding, padding end
		if style.paddingX then r, l = style.paddingX, style.paddingX end
		if style.paddingY then t, b = style.paddingY, style.paddingY end
		decorations.padding = { class = "UIPadding", PaddingTop = dim(t), PaddingRight = dim(r), PaddingBottom = dim(b), PaddingLeft = dim(l) }
	end
	if style.minWidth or style.maxWidth or style.minHeight or style.maxHeight then
		decorations.constraint = { class = "UISizeConstraint", MinSize = Vector2.new(style.minWidth or 0, style.minHeight or 0),
			MaxSize = Vector2.new(style.maxWidth or 100000, style.maxHeight or 100000) }
	end
	if style.direction then
		assert(style.direction == "row" or style.direction == "column", "Direction must be row or column")
		local layout = { class = "UIListLayout", FillDirection = if style.direction == "row" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder, Padding = dim(style.gap or 0),
			HorizontalAlignment = enum({start=Enum.HorizontalAlignment.Left,center=Enum.HorizontalAlignment.Center,["end"]=Enum.HorizontalAlignment.Right}, style.horizontalAlign or "start", "horizontalAlign"),
			VerticalAlignment = enum({start=Enum.VerticalAlignment.Top,center=Enum.VerticalAlignment.Center,["end"]=Enum.VerticalAlignment.Bottom}, style.verticalAlign or "start", "verticalAlign"),
			HorizontalFlex=Enum.UIFlexAlignment.None,VerticalFlex=Enum.UIFlexAlignment.None,Wraps=style.wrap or false }
		if style.distribute then
			local flex = enum({fill=Enum.UIFlexAlignment.Fill,between=Enum.UIFlexAlignment.SpaceBetween,around=Enum.UIFlexAlignment.SpaceAround,evenly=Enum.UIFlexAlignment.SpaceEvenly}, style.distribute, "distribute")
			layout[if style.direction == "row" then "HorizontalFlex" else "VerticalFlex"] = flex
		end
		if style.wrap ~= nil then layout.Wraps = style.wrap end
		decorations.layout = layout
	end
	if style.grow or style.shrink then
		decorations.flex = { class = "UIFlexItem", FlexMode = Enum.UIFlexMode.Custom, GrowRatio = style.grow or 0, ShrinkRatio = style.shrink or 0 }
	end
	return props, decorations
end
Style.dim = dim
return Style

end
-- END styling/StyleResolver

-- BEGIN runtime/Input
__modules["runtime/Input"] = function(__require)
--!nonstrict
local Scope = __require("utils/Scope")
local Diagnostics = __require("utils/Diagnostics")
local Input = {}
Input.__index = Input
function Input.isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
function Input.visible(instance)
	local node = instance
	while node do
		if node:IsA("GuiObject") and (not node.Visible or node.AbsoluteSize.X &lt;= 0 or node.AbsoluteSize.Y &lt;= 0) then return false end
		if node:IsA("ScreenGui") and not node.Enabled then return false end
		node = node.Parent
	end
	return instance ~= nil and instance.Parent ~= nil
end
function Input.inside(instance, position)
	if not instance or not Input.visible(instance) then return false end
	local origin, size = instance.AbsolutePosition, instance.AbsoluteSize
	return position.X &gt;= origin.X and position.X &lt;= origin.X + size.X and position.Y &gt;= origin.Y and position.Y &lt;= origin.Y + size.Y
end
function Input.new(uis, guiService)
	local self = setmetatable({ uis = uis, guiService = guiService, scope = Scope.new(), listeners = {began={},ended={}}, serial=0 }, Input)
	self.scope:Connect(uis.InputBegan, function(input, processed) self:_dispatch("began", input, processed) end)
	self.scope:Connect(uis.InputChanged, function(input)
		local capture = self.capture
		if capture and ((capture.input.UserInputType == Enum.UserInputType.Touch and input == capture.input)
			or (capture.input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			capture.move(input.Position)
		end
	end)
	self.scope:Connect(uis.InputEnded, function(input, processed)
		local capture = self.capture
		if capture and (input == capture.input or (capture.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			self.capture = nil
			capture.finish(false)
		end
		self:_dispatch("ended", input, processed)
	end)
	self.scope:Connect(uis.WindowFocusReleased, function()
		if self.capture then local old=self.capture; self.capture=nil; old.finish(true) end
		self:_dispatch("ended", nil, true)
	end)
	return self
end
function Input:_dispatch(kind, input, processed)
	local list = {}
	for token, listener in self.listeners[kind] do table.insert(list, {token=token, listener=listener}) end
	table.sort(list, function(a,b) return a.token &gt; b.token end)
	for _, item in list do
		if self.listeners[kind][item.token] then
			local ok, consumed = pcall(item.listener, input, processed)
			if not ok then warn("MattLib input: " .. tostring(consumed)) elseif consumed then break end
		end
	end
end
function Input:Subscribe(kind, callback)
	assert(self.listeners[kind], "Invalid input subscription")
	self.serial += 1
	local token = self.serial
	self.listeners[kind][token] = callback
	Diagnostics.add("subscriptions",1)
	return function()
		if self.listeners[kind][token] then self.listeners[kind][token]=nil; Diagnostics.add("subscriptions",-1) end
	end
end
function Input:Capture(input, move, finish)
	if self.capture then local previous=self.capture; self.capture=nil; previous.finish(true) end
	local capture = { input=input, move=move, finish=finish or function() end }
	self.capture = capture
	return function() if self.capture == capture then self.capture=nil; capture.finish(true) end end
end
function Input:OnKey(ref, callback, descendants)
	return self:Subscribe("began", function(input, processed)
		local instance = ref.current
		if not input or input.UserInputType ~= Enum.UserInputType.Keyboard or not Input.visible(instance) then return end
		local selected, focused = self.guiService.SelectedObject, self.uis:GetFocusedTextBox()
		local target = focused or selected
		if target == instance or (descendants and target and target:IsDescendantOf(instance)) then
			return callback(input.KeyCode, input, processed)
		end
	end)
end
function Input:Destroy()
	if self.capture then local old=self.capture; self.capture=nil; old.finish(true) end
	self.scope:Destroy()
	for _,listeners in self.listeners do for _ in listeners do Diagnostics.add("subscriptions",-1) end end
	self.listeners = {began={},ended={}}
end
return Input

end
-- END runtime/Input

-- BEGIN core/Host
__modules["core/Host"] = function(__require)
--!nonstrict
local Scope = __require("utils/Scope")
local Diagnostics = __require("utils/Diagnostics")
local Style = __require("styling/StyleResolver")
local Input = __require("runtime/Input")
local Host = {}
local classes = {Frame=true,CanvasGroup=true,TextLabel=true,TextButton=true,TextBox=true,ImageLabel=true,ImageButton=true,ScrollingFrame=true}
local tweenable = {BackgroundColor3=true,BackgroundTransparency=true,TextColor3=true,TextTransparency=true,
	ImageColor3=true,ImageTransparency=true,Position=true,Size=true,Rotation=true,GroupTransparency=true}
local function setRef(ref, value)
	if type(ref) == "function" then ref(value)
	elseif ref ~= nil then assert(type(ref) == "table", "ref must be a table or callback"); ref.current = value end
end
local function protected(node, callback, ...)
	local ok, err = pcall(callback, ...)
	if not ok then node.root:report(err) end
end
local function updateProperties(node, desired, animate)
	local instance, goals = node.instance, {}
	node.applying = true
	for property in node.assigned do
		if desired[property] == nil then
			node.env.animator:Cancel(instance, "style")
			instance[property] = node.original[property]
		end
	end
	for property, value in desired do
		assert(property ~= "Parent" and property ~= "ClassName", "Renderer owns " .. property)
		if node.original[property] == nil then node.original[property] = instance[property] end
		if node.assigned[property] ~= value or (property == "Text" and instance[property] ~= value) then
			if animate and tweenable[property] and node.assigned[property] ~= nil and node.assigned[property] ~= value then goals[property] = value
			elseif instance[property] ~= value then instance[property] = value end
		end
	end
	node.assigned, node.applying = desired, false
	if next(goals) then node.env.animator:To(instance, goals, node.env.theme:Get().motion.fast, {channel="style",merge=true}) end
end
function Host.refresh(node, animate)
	if not node.alive then return end
	local props, decorations = Style.resolve(node.props.style, node.env.theme:Get(), node.states, node.className)
	local desired = {BorderSizePixel=0, BackgroundTransparency=1}
	for key, value in node.props.native or {} do desired[key] = value end
	for key, value in props do desired[key] = value end
	desired.Name = node.props.name or node.className
	if node.instance:IsA("GuiButton") then
		desired.AutoButtonColor, desired.Active = false, not node.props.disabled
		desired.Selectable, desired.Interactable = not node.props.disabled, not node.props.disabled
	end
	if node.className == "TextBox" then desired.TextEditable = not node.props.disabled end
	updateProperties(node, desired, animate and node.props.motion ~= false)
	for key, instance in table.clone(node.decorations) do
		if not decorations[key] then
			node.env.animator:Forget(instance)
			instance:Destroy(); node.decorations[key] = nil; Diagnostics.add("instances", -1)
		end
	end
	for key, spec in decorations do
		local instance = node.decorations[key]
		if not instance then
			instance = Instance.new(spec.class)
			instance.Name = "Matt_" .. key
			node.decorations[key] = instance
			Diagnostics.add("instances", 1)
		end
		for property, value in spec do if property ~= "class" and instance[property] ~= value then instance[property] = value end end
		instance.Parent = node.instance
	end
end
local function state(node, name, value)
	if node.states[name] == value then return end
	node.states[name] = value
	Host.refresh(node, true)
end
local function syncBindings(node, category, definitions)
	local bindings = node[category]
	for name, binding in table.clone(bindings) do
		if not definitions[name] then binding.disconnect(); bindings[name] = nil end
	end
	for name, callback in definitions do
		assert(type(callback) == "function", category .. " callbacks must be functions")
		if bindings[name] then bindings[name].callback = callback
		else
			local signal = if category == "changes" then node.instance:GetPropertyChangedSignal(name) else node.instance[name]
			local binding = {callback=callback}
			binding.disconnect = node.scope:Connect(signal, function(...)
				if not node.alive or node.applying or node.props.disabled then return end
				protected(node, binding.callback, node.instance, ...)
			end)
			bindings[name] = binding
		end
	end
end
function Host.create(node, className)
	assert(classes[className], "Unsupported native host class: " .. className)
	node.instance, node.className, node.scope = Instance.new(className), className, Scope.new()
	node.decorations, node.assigned, node.original, node.events, node.changes, node.attributes = {}, {}, {}, {}, {}, {}
	node.states = {hover=false,pressed=false,focus=false,active=false,disabled=false}
	Diagnostics.add("instances", 1)
end
function Host.update(node, props, env)
	local oldRef = node.props and node.props.ref
	node.props, node.env = props, env
	node.states.disabled, node.states.active = props.disabled == true, props.active == true
	if node.theme ~= env.theme then
		if node.themeDisconnect then node.scope:Remove(node.themeDisconnect, true) end
		node.theme = env.theme
		node.themeDisconnect = node.scope:Add(env.theme.signal:subscribe(function() Host.refresh(node, false) end))
	end
	Host.refresh(node, node.mounted == true)
	syncBindings(node, "events", props.events or {})
	syncBindings(node, "changes", props.changes or {})
	local attributes = table.clone(props.attributes or {})
	attributes.AsterRole, attributes.AsterLabel, attributes.AsterValue = props.role, props.accessibleName, props.accessibleValue
	for name in node.attributes do if attributes[name] == nil then node.instance:SetAttribute(name, nil) end end
	for name, value in attributes do node.instance:SetAttribute(name, value) end
	node.attributes = attributes
	local wantsStates = props.style and (props.style.hover or props.style.pressed or props.style.focus)
	if wantsStates and not node.stateScope then
		node.stateScope = Scope.new()
		node.stateScope:Connect(node.instance.MouseEnter, function() state(node,"hover",true) end)
		node.stateScope:Connect(node.instance.MouseLeave, function() state(node,"hover",false); state(node,"pressed",false) end)
		node.stateScope:Connect(node.instance.SelectionGained, function() state(node,"focus",true) end)
		node.stateScope:Connect(node.instance.SelectionLost, function() state(node,"focus",false) end)
		if node.className == "TextBox" then
			node.stateScope:Connect(node.instance.Focused, function() state(node,"focus",true) end)
			node.stateScope:Connect(node.instance.FocusLost, function() state(node,"focus",false) end)
		end
		node.stateScope:Connect(node.instance.InputBegan, function(input)
			if not node.props.disabled and Input.isPointer(input) then state(node,"pressed",true) end
		end)
		node.stateScope:Add(env.input:Subscribe("ended", function() state(node,"pressed",false) end))
	elseif not wantsStates and node.stateScope then node.stateScope:Destroy(); node.stateScope=nil end
	if node.instance:IsA("GuiButton") and not node.keyboard then
		node.keyboard = node.scope:Add(env.input:OnKey({current=node.instance}, function(key)
			if not node.props.disabled and not env.input.uis:GetFocusedTextBox() and (key == Enum.KeyCode.Return or key == Enum.KeyCode.Space) then
				local binding = node.events.Activated
				if binding then protected(node, binding.callback, node.instance); return true end
			end
		end))
	end
	if oldRef ~= props.ref then setRef(oldRef, nil); setRef(props.ref, node.instance) end
	node.mounted = true
end
function Host.destroy(node)
	setRef(node.props and node.props.ref, nil)
	if node.stateScope then node.stateScope:Destroy() end
	node.scope:Destroy()
	node.env.animator:Forget(node.instance)
	for _, instance in node.decorations do node.env.animator:Forget(instance); instance:Destroy(); Diagnostics.add("instances", -1) end
	node.instance:Destroy()
	Diagnostics.add("instances", -1)
end
return Host

end
-- END core/Host

-- BEGIN core/Renderer
__modules["core/Renderer"] = function(__require)
--!nonstrict
local Element = __require("core/Element")
local Reconciler = __require("core/Reconciler")
local Hooks = __require("core/Hooks")
local Host = __require("core/Host")
local Diagnostics = __require("utils/Diagnostics")
local Renderer = {}
local Root = {}
Root.__index = Root
local function orderHosts(node, counters)
	if node.instance then
		local parent = node.instance.Parent
		counters[parent] = (counters[parent] or 0) + 1
		local explicit = (node.props.native or {}).LayoutOrder
		local order = explicit or counters[parent]
		if node.instance.LayoutOrder ~= order then node.instance.LayoutOrder = order end
	end
	for _, child in node.children do orderHosts(child, counters) end
end
function Root:report(err)
	if self.onError then
		local ok, nested = pcall(self.onError, tostring(err))
		if not ok then warn("MattLib onError: " .. tostring(nested)) end
	else warn("MattLib: " .. tostring(err)) end
end
function Root:_unmount(node)
	if not node or not node.alive then return end
	node.alive = false
	self.dirty[node] = nil
	if type(node.kind) == "function" then Hooks.cleanup(node); Diagnostics.add("components", -1) end
	for _, child in node.children do self:_unmount(child) end
	if node.instance then Host.destroy(node) end
	node.children = {}
end
function Root:_children(node, elements, parentHost, env)
	local plan, removed = Reconciler.plan(node.children, elements)
	local nextChildren = {}
	-- Keep in-progress children reachable if a later child fails to render.
	local retained = table.clone(node.children)
	node.children = retained
	for _, old in removed do self:_unmount(old); self.needsOrder=true end
	for index, match in plan do
		local child = self:_reconcile(match.previous, match.element, parentHost, node, env)
		nextChildren[index] = child
		if not match.previous then self.needsOrder=true end
		if retained[index] ~= child then self.needsOrder=true end
	end
	node.children = nextChildren
end
function Root:_render(node)
	node.epoch = self.epoch
	Diagnostics.add("renders", 1)
	local previous = Hooks.begin(node)
	local ok, result = pcall(node.kind, node.element.props)
	local finishOk, finishErr = pcall(Hooks.finish, node, previous, ok)
	if not ok then error(result, 0) end
	if not finishOk then error(finishErr, 0) end
	self:_children(node, Element.children(result), node.parentHost, node.env)
end
function Root:_reconcile(node, element, parentHost, owner, env)
	local kind = Element.resolve(element.type)
	if node and node.kind ~= kind then self:_unmount(node); node=nil; self.needsOrder=true end
	if not node then
		node = {kind=kind,element=element,root=self,owner=owner,env=env,parentHost=parentHost,children={},hooks={},alive=true,depth=owner.depth+1}
		-- Ownership is recorded before any user code or property assignment can fail.
		table.insert(owner.children, node)
		if type(kind) == "function" then Diagnostics.add("components", 1)
		elseif type(kind) == "string" then Host.create(node, string.sub(kind, 2)) end
	end
	node.element, node.owner, node.env, node.parentHost = element, owner, env, parentHost
	if type(kind) == "function" then self:_render(node)
	elseif kind == Element.Fragment then self:_children(node, element.props.children, parentHost, env)
	elseif kind == Element.Portal then
		assert(typeof(element.props.target) == "Instance", "Portal target must be an Instance")
		self:_children(node, element.props.children, element.props.target, env)
	elseif kind == Element.Provider then
		local nextEnv = table.clone(env)
		assert(element.props.service and element.props.service.signal, "Theme provider requires a Theme service")
		nextEnv.theme = element.props.service
		self:_children(node, element.props.children, parentHost, nextEnv)
	else
		Host.update(node, element.props, env)
		if node.instance.Parent ~= parentHost then node.instance.Parent=parentHost; self.needsOrder=true end
		self:_children(node, element.props.children, node.instance, env)
	end
	return node
end
function Root:enqueue(node)
	if not self.alive or not node.alive then return end
	self.dirty[node] = true
	self:_schedule()
end
function Root:_schedule()
	if self.scheduled or self.flushing or not self.alive then return end
	self.scheduled = true
	task.defer(function()
		if not self.alive or not self.scheduled then return end
		self.scheduled = false
		local ok, err = pcall(function() self:Flush() end)
		if not ok then self:report(err) end
	end)
end
function Root:_flush()
	local iterations = 0
	while self.pending or next(self.dirty) or next(self.effects) do
		iterations += 1
		assert(iterations &lt;= 50, "MattLib: effects produced an infinite update loop")
		self.epoch += 1
		local dirty = self.dirty
		self.dirty = {}
		if self.pending then
			local pending = self.pending
			self.pending = nil
			self:_children(self.tree, Element.children(pending.element), self.parent, self.env)
		else
			local nodes = {}
			for node in dirty do table.insert(nodes, node) end
			table.sort(nodes, function(a,b) return a.depth &lt; b.depth end)
			for _, node in nodes do if node.alive and node.epoch ~= self.epoch then self:_render(node) end end
		end
		if self.needsOrder then orderHosts(self.tree, {}); self.needsOrder=false end
		Hooks.commit(self)
	end
end
function Root:Flush()
	assert(self.alive, "Cannot flush an unmounted root")
	assert(not self.flushing, "Reentrant flush is unsupported")
	self.flushing, self.scheduled = true, false
	local ok, err = pcall(function() self:_flush() end)
	self.flushing = false
	if not ok then self:Unmount(); error(err, 0) end
	return self
end
function Root:Update(element)
	assert(self.alive, "Cannot update an unmounted root")
	self.pending = {element=element}
	self:_schedule()
	return self
end
function Root:Unmount()
	if not self.alive then return end
	self.alive, self.scheduled = false, false
	self:_unmount(self.tree)
	self.dirty, self.effects, self.pending = {}, {}, nil
	Diagnostics.add("roots", -1)
	if self.onUnmount then self.onUnmount(self) end
end
function Root:Find(name)
	local function find(node)
		if node.instance and node.instance.Name == name then return node.instance end
		for _, child in node.children do local result=find(child); if result then return result end end
	end
	return find(self.tree)
end
function Renderer.mount(element, parent, env, options)
	assert(typeof(parent) == "Instance", "Mount parent must be an Instance")
	options = options or {}
	local root = setmetatable({alive=true,parent=parent,env=env,onError=options.onError,onUnmount=options.onUnmount,
		dirty={},effects={},epoch=0,pending={element=element}}, Root)
	root.tree = {alive=true,children={},kind=Element.Fragment,depth=0,root=root}
	Diagnostics.add("roots", 1)
	root:Flush()
	return root
end
return Renderer

end
-- END core/Renderer

-- BEGIN runtime/Adapter
__modules["runtime/Adapter"] = function(__require)
--!nonstrict
local Scope = __require("utils/Scope")
local Signal = __require("core/Signal")
local Diagnostics = __require("utils/Diagnostics")
local Adapter = {}
Adapter.__index = Adapter
function Adapter.capabilities(overrides)
	local environment = getfenv(0)
	local result = {}
	for _, name in { "gethui", "readfile", "writefile", "isfile", "makefolder", "isfolder" } do
		local value = if overrides then overrides[name] else environment[name]
		if type(value) == "function" then result[name] = value end
	end
	return result
end
function Adapter.parent(services, capabilities, explicit)
	if explicit then
		assert(typeof(explicit) == "Instance", "parent must be a Roblox Instance")
		return explicit, "explicit"
	end
	if capabilities.gethui then
		local ok, parent = pcall(capabilities.gethui)
		if ok and typeof(parent) == "Instance" then return parent, "gethui" end
	end
	local player = services.Players.LocalPlayer
	assert(player, "MattLib runs on the client. Use a LocalScript in Studio Play mode.")
	return player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10), "PlayerGui"
end
local function make(self, className, name, parent)
	local instance = Instance.new(className)
	Diagnostics.add("instances", 1)
	self.scope:Add(function() instance:Destroy(); Diagnostics.add("instances", -1) end)
	instance.Name, instance.Parent = name, parent
	return instance
end
function Adapter.new(options, onDestroy)
	options = options or {}
	local services = {}
	for _, name in { "Players", "UserInputService", "GuiService", "TweenService", "HttpService", "RunService" } do services[name] = game:GetService(name) end
	local capabilities = Adapter.capabilities(options.capabilities)
	local parent, mode = Adapter.parent(services, capabilities, options.parent)
	assert(parent, "PlayerGui is unavailable")
	local id = options.id or "default"
	assert(type(id) == "string" and #id &gt; 0, "Library id must be a nonempty string")
	local name = "MattLib:" .. id
	for _, previous in parent:GetChildren() do
		if previous.Name == name and previous:GetAttribute("MattLibRoot") == true then
			local dispose = previous:FindFirstChild("__AsterDispose")
			if dispose and dispose:IsA("BindableFunction") then pcall(function() dispose:Invoke() end) end
			previous:Destroy()
		end
	end
	local self = setmetatable({scope=Scope.new(), services=services, capabilities=capabilities, parentMode=mode, alive=true}, Adapter)
	self.screen = make(self, "ScreenGui", name, parent)
	self.screen.ResetOnSpawn, self.screen.ZIndexBehavior = false, Enum.ZIndexBehavior.Sibling
	self.screen.DisplayOrder = options.displayOrder or 50
	self.screen.IgnoreGuiInset = false
	-- Older clients keep the standard IgnoreGuiInset=false behavior.
	pcall(function() self.screen.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets; self.screen.ClipToDeviceSafeArea = true end)
	self.screen:SetAttribute("MattLibRoot", true)
	local dispose = make(self, "BindableFunction", "__AsterDispose", self.screen)
	dispose.OnInvoke = onDestroy
	self.scope:Connect(self.screen.Destroying, function() if self.alive then onDestroy() end end)
	self.layers = {}
	for index, layerName in { "main", "overlay", "toast" } do
		local layer = make(self, "Frame", layerName, self.screen)
		layer.Size, layer.BackgroundTransparency, layer.BorderSizePixel = UDim2.fromScale(1, 1), 1, 0
		layer.ZIndex = index * 1000
		self.layers[layerName] = layer
	end
	local camera=workspace.CurrentCamera
	self.viewport = Signal.new(if camera then camera.ViewportSize else Vector2.new(800,600))
	self.layoutReady=false
	self.scope:Connect(self.layers.main:GetPropertyChangedSignal("AbsoluteSize"), function()
		if self.layoutReady then self.viewport:set(self.layers.main.AbsoluteSize) end
	end)
	-- Read engine layout after its first frame; freshly parented GUI sizes can be provisional.
	local disconnect
	disconnect=self.scope:Connect(services.RunService.Heartbeat,function()
		disconnect(); self.layoutReady=true
		self.viewport:set(self.layers.main.AbsoluteSize)
	end)
	return self
end
function Adapter:Destroy()
	if not self.alive then return end
	self.alive = false
	self.scope:Destroy()
	self.viewport:Destroy()
end
return Adapter

end
-- END runtime/Adapter

-- BEGIN runtime/Overlays
__modules["runtime/Overlays"] = function(__require)
--!nonstrict
local Scope = __require("utils/Scope")
local Input = __require("runtime/Input")
local Overlays = {}
Overlays.__index = Overlays
function Overlays.new(input)
	return setmetatable({input=input,stack={},serial=0},Overlays)
end
function Overlays:Allows(instance)
	for index=#self.stack,1,-1 do
		local record=self.stack[index]
		if record.modal then return instance==record.root or (instance and instance:IsDescendantOf(record.root)) end
	end
	return true
end
function Overlays:NextZ() self.serial+=1; return self.serial end
local function targets(root)
	local output = {}
	for _, instance in root:GetDescendants() do
		if instance:IsA("GuiObject") and instance.Selectable and instance.Interactable and Input.visible(instance) then table.insert(output,instance) end
	end
	table.sort(output,function(a,b) return a.SelectionOrder &lt; b.SelectionOrder end)
	return output
end
function Overlays:Attach(root, dismiss, modal, anchor, priority)
	local scope = Scope.new()
	local uis, gui = self.input.uis, self.input.guiService
	local record = {root=root,modal=modal,previous=gui.SelectedObject,focused=uis:GetFocusedTextBox(),priority=priority or 0}
	table.insert(self.stack,record)
	table.sort(self.stack,function(a,b) return a.priority&lt;b.priority end)
	local function top() return self.stack[#self.stack] == record end
	local function selectTarget(target)
		if not target then return end
		gui.SelectedObject = target
		if target:IsA("TextBox") then target:CaptureFocus() end
	end
	if modal then
		local didFocus=false
		local function initialFocus()
			if didFocus or not top() then return end
			local first=targets(root)[1]
			if first then didFocus=true; selectTarget(first) end
		end
		initialFocus()
		scope:Delay(0,initialFocus)
		scope:Connect(root:GetPropertyChangedSignal("AbsoluteSize"),function() if not didFocus then scope:Delay(0,initialFocus) end end)
	end
	scope:Add(self.input:Subscribe("began",function(input)
		if not top() or not input then return end
		local key = input.KeyCode
		if key == Enum.KeyCode.Escape then if dismiss then dismiss() end; return true end
		if modal and key == Enum.KeyCode.Tab then
			local candidates=targets(root)
			if #candidates&gt;0 then
				local selected=uis:GetFocusedTextBox() or gui.SelectedObject
				local index=table.find(candidates,selected) or 0
				local direction=if uis:IsKeyDown(Enum.KeyCode.LeftShift) or uis:IsKeyDown(Enum.KeyCode.RightShift) then -1 else 1
				local focused=uis:GetFocusedTextBox()
				if focused then focused:ReleaseFocus() end
				selectTarget(candidates[(index-1+direction)%#candidates+1])
			end
			return true
		end
		if not modal and Input.isPointer(input) and not Input.inside(root,input.Position)
			and not (anchor and Input.inside(anchor,input.Position)) then
			if dismiss then dismiss() end
		end
	end))
	if modal then
		scope:Connect(gui:GetPropertyChangedSignal("SelectedObject"),function()
			local selected=gui.SelectedObject
			if top() and selected and selected~=root and not selected:IsDescendantOf(root) then selectTarget(targets(root)[1]) end
		end)
	end
	return function()
		local wasTop=top()
		local index=table.find(self.stack,record)
		if index then table.remove(self.stack,index) end
		scope:Destroy()
		if wasTop then
			local focused=uis:GetFocusedTextBox()
			if focused and focused:IsDescendantOf(root) then focused:ReleaseFocus() end
			if record.previous and Input.visible(record.previous) then gui.SelectedObject=record.previous
			elseif gui.SelectedObject and gui.SelectedObject:IsDescendantOf(root) then gui.SelectedObject=nil end
			if record.focused and not record.focused:IsDescendantOf(root) and Input.visible(record.focused) then record.focused:CaptureFocus() end
		end
	end
end
function Overlays:Destroy() table.clear(self.stack) end
return Overlays

end
-- END runtime/Overlays

-- BEGIN window/Manager
__modules["window/Manager"] = function(__require)
--!nonstrict
local Scope=__require("utils/Scope")
local Diagnostics=__require("utils/Diagnostics")
local Signal=__require("core/Signal")
local Input=__require("runtime/Input")
local Manager={}
Manager.__index=Manager
local Entry={}
Entry.__index=Entry
function Manager.clamp(rect,viewport,minSize,maxSize)
	local margin=math.min(8,math.max(0,(math.min(viewport.X,viewport.Y)-1)/2))
	local availableW,availableH=math.max(1,viewport.X-margin*2),math.max(1,viewport.Y-margin*2)
	local minW,minH=math.min((minSize or {}).X or 280,availableW),math.min((minSize or {}).Y or 180,availableH)
	local maxW,maxH=math.max(minW,math.min((maxSize or {}).X or availableW,availableW)),math.max(minH,math.min((maxSize or {}).Y or availableH,availableH))
	local width,height=math.clamp(rect.width,minW,maxW),math.clamp(rect.height,minH,maxH)
	return {x=math.clamp(rect.x,margin,math.max(margin,viewport.X-width-margin)),y=math.clamp(rect.y,margin,math.max(margin,viewport.Y-height-margin)),width=width,height=height}
end
function Manager.new(runtime,input,overlays)
	local self=setmetatable({runtime=runtime,input=input,overlays=overlays,entries={},scope=Scope.new(),serial=0,hidden=Signal.new({})},Manager)
	self.scope:Add(runtime.viewport:subscribe(function() for _,entry in self.entries do entry:_apply() end end))
	return self
end
function Manager:_viewport()
	-- Signals can be delivered later under Roblox's deferred event mode.
	-- A gesture/explicit resize must use the current native safe-area dimensions.
	local actual=self.runtime.layers.main.AbsoluteSize
	if actual.X&gt;0 and actual.Y&gt;0 then return actual end
	local viewport=self.runtime.viewport:get()
	if viewport.X&lt;1 or viewport.Y&lt;1 then
		local camera=workspace.CurrentCamera
		return if camera then camera.ViewportSize else Vector2.new(800,600)
	end
	return viewport
end
function Manager:_publish()
	local hidden={}
	for _,entry in self.entries do if not entry.visible then table.insert(hidden,entry) end end
	table.sort(hidden,function(a,b) return a.order&lt;b.order end)
	self.hidden:set(hidden)
end
function Entry:_apply()
	if not self.alive then return end
	local minSize=if self.minimized then Vector2.new(self.minSize.X,44) else self.minSize
	self.rect=Manager.clamp(self.rect,self.manager:_viewport(),minSize,self.maxSize)
	self.frame.Position=UDim2.fromOffset(self.rect.x,self.rect.y)
	self.frame.Size=UDim2.fromOffset(self.rect.width,self.rect.height)
end
function Entry:Focus()
	if not self.alive then return end
	self.manager.serial+=1
	self.frame.ZIndex=self.manager.serial
end
function Entry:Show()
	if not self.alive then return end
	self.visible=true; self.options.onVisible(true); self:Focus(); self.manager:_publish()
end
function Entry:Hide()
	if not self.alive then return end
	self.visible=false; self.options.onVisible(false); self.manager:_publish()
end
function Entry:Minimize()
	if not self.alive or self.minimized then return end
	self.savedHeight=self.rect.height; self.rect.height=44; self.minimized=true
	self.options.onMinimized(true); self:_apply()
end
function Entry:Restore()
	if not self.alive then return end
	if self.minimized then
		self.rect.height=self.savedHeight or self.options.size[2]; self.minimized=false
		self.options.onMinimized(false); self:_apply()
	end
	self:Show()
end
function Entry:SetSize(width,height)
	assert(type(width)=="number" and width&gt;0 and width&lt;math.huge and type(height)=="number" and height&gt;0 and height&lt;math.huge,"Window size must be finite and positive")
	if not self.alive then return end
	self.rect.width=width
	if self.minimized then self.savedHeight=height; self.rect.height=44 else self.rect.height=height end
	self:_apply()
end
function Entry:GetRect() return table.clone(self.rect) end
function Entry:Close()
	if self.alive and not self.closing then self.closing=true; self.options.onClose() end
end
function Entry:Detach()
	if not self.alive then return end
	self.alive=false; self.scope:Destroy()
	if self.manager.entries[self.id]==self then self.manager.entries[self.id]=nil end
	Diagnostics.add("windows",-1); self.manager:_publish()
end
function Entry:Destroy()
	if not self.alive then return end
	self:Close(); self:Detach()
end
function Manager:Register(options)
	assert(type(options.id)=="string","Window id must be a string")
	if self.entries[options.id] then self.entries[options.id]:Destroy() end
	local viewport=self:_viewport()
	local size=options.size or {720,500}
	assert(type(size[1])=="number" and size[1]&gt;0 and size[1]&lt;math.huge and type(size[2])=="number" and size[2]&gt;0 and size[2]&lt;math.huge,"Invalid window size")
	local point=options.position or {(viewport.X-size[1])/2,(viewport.Y-size[2])/2}
	self.serial+=1
	local entry=setmetatable({manager=self,id=options.id,options=options,scope=Scope.new(),alive=true,frame=options.frame,
		visible=options.visible~=false,minimized=false,minSize=options.minSize or Vector2.new(280,180),maxSize=options.maxSize,
		order=self.serial,rect={x=point[1],y=point[2],width=size[1],height=size[2]}},Entry)
	self.entries[entry.id]=entry; Diagnostics.add("windows",1)
	local cancelCapture
	entry.scope:Add(function() if cancelCapture then cancelCapture(); cancelCapture=nil end end)
	entry.scope:Connect(options.frame.InputBegan,function(input) if Input.isPointer(input) then entry:Focus() end end)
	entry.scope:Connect(options.titlebar.InputBegan,function(input)
		if not Input.isPointer(input) then return end
		for _,child in options.titlebar:GetDescendants() do if child:IsA("GuiButton") and Input.inside(child,input.Position) then return end end
		entry:Focus()
		local start,rect=input.Position,entry:GetRect()
		cancelCapture=self.input:Capture(input,function(pointNow)
			entry.rect.x,entry.rect.y=rect.x+pointNow.X-start.X,rect.y+pointNow.Y-start.Y; entry:_apply()
		end,function(cancelled) cancelCapture=nil; if not cancelled and options.onMove then options.onMove(entry:GetRect()) end end)
	end)
	if options.grip and not options.fixedSize then
		entry.scope:Connect(options.grip.InputBegan,function(input)
			if not Input.isPointer(input) or entry.minimized then return end
			entry:Focus()
			local start,rect=input.Position,entry:GetRect()
			cancelCapture=self.input:Capture(input,function(pointNow)
				entry.rect.width,entry.rect.height=rect.width+pointNow.X-start.X,rect.height+pointNow.Y-start.Y; entry:_apply()
			end,function(cancelled) cancelCapture=nil; if not cancelled and options.onResize then options.onResize(entry:GetRect()) end end)
		end)
		entry.scope:Add(self.input:OnKey({current=options.grip},function(key)
			local dx=if key==Enum.KeyCode.Right then 10 elseif key==Enum.KeyCode.Left then -10 else 0
			local dy=if key==Enum.KeyCode.Down then 10 elseif key==Enum.KeyCode.Up then -10 else 0
			if dx~=0 or dy~=0 then entry:SetSize(entry.rect.width+dx,entry.rect.height+dy); return true end
		end))
	end
	entry.scope:Add(self.input:OnKey({current=options.titlebar},function(key)
		local dx=if key==Enum.KeyCode.Right then 10 elseif key==Enum.KeyCode.Left then -10 else 0
		local dy=if key==Enum.KeyCode.Down then 10 elseif key==Enum.KeyCode.Up then -10 else 0
		if dx~=0 or dy~=0 then entry.rect.x+=dx; entry.rect.y+=dy; entry:_apply(); return true end
	end))
	if options.openKey~=false then
		local name=options.openKey or "RightShift"
		if typeof(name)=="EnumItem" then name=name.Name end
		assert(type(name)=="string","openKey must be a KeyCode name, EnumItem, or false")
		entry.scope:Add(self.input:Subscribe("began",function(input,processed)
			if not input or processed or #self.overlays.stack&gt;0 or self.input.uis:GetFocusedTextBox() then return end
			if input.KeyCode.Name==name then if entry.visible then entry:Hide() else entry:Show() end end
		end))
	end
	entry:_apply(); entry:Focus(); self:_publish()
	return entry
end
function Manager:Destroy()
	for _,entry in table.clone(self.entries) do entry:Detach() end
	self.scope:Destroy(); self.hidden:Destroy()
end
return Manager

end
-- END window/Manager

-- BEGIN animation/Animator
__modules["animation/Animator"] = function(__require)
--!nonstrict
local Scope = __require("utils/Scope")
local Diagnostics = __require("utils/Diagnostics")
local Animator = {}
Animator.__index = Animator
function Animator.new(service, reducedMotion)
	return setmetatable({ service = service, reducedMotion = reducedMotion == true, active = {}, alive = true }, Animator)
end
function Animator:Cancel(instance, channel, finish)
	local channels = self.active[instance]
	local record = channels and channels[channel or "default"]
	if not record then return end
	channels[channel or "default"] = nil
	if next(channels) == nil then self.active[instance] = nil end
	record.scope:Destroy()
	record.tween:Cancel()
	Diagnostics.add("tweens", -1)
	if finish then for property, value in record.goals do instance[property] = value end end
	if finish and record.onComplete then record.onComplete() end
end
function Animator:To(instance, goals, duration, options)
	assert(self.alive, "Animator is destroyed")
	options = options or {}
	local channel = options.channel or "default"
	local previous=(self.active[instance] or {})[channel]
	if options.merge and previous then
		local combined=table.clone(previous.goals)
		for property,value in goals do combined[property]=value end
		goals=combined
	end
	self:Cancel(instance, channel)
	if self.reducedMotion or duration == 0 then
		for property, value in goals do instance[property] = value end
		if options.onComplete then options.onComplete() end
		return function() end
	end
	local tween = self.service:Create(instance, TweenInfo.new(duration or 0.18,
		options.easing or Enum.EasingStyle.Quad, options.direction or Enum.EasingDirection.Out,
		options.repeatCount or 0, options.reverses or false), goals)
	local record = { tween = tween, goals = goals, scope = Scope.new(),onComplete=options.onComplete }
	self.active[instance] = self.active[instance] or {}
	self.active[instance][channel] = record
	Diagnostics.add("tweens", 1)
	record.scope:Connect(tween.Completed, function(state)
		if (self.active[instance] or {})[channel] ~= record then return end
		self.active[instance][channel] = nil
		if next(self.active[instance]) == nil then self.active[instance] = nil end
		record.scope:Destroy()
		Diagnostics.add("tweens", -1)
		if state == Enum.PlaybackState.Completed and options.onComplete then options.onComplete() end
	end)
	tween:Play()
	return function() if (self.active[instance] or {})[channel] == record then self:Cancel(instance, channel) end end
end
function Animator:Forget(instance)
	local channels = self.active[instance]
	if channels then for channel in table.clone(channels) do self:Cancel(instance, channel) end end
end
function Animator:SetReducedMotion(value)
	self.reducedMotion = value == true
	if self.reducedMotion then
		for instance, channels in table.clone(self.active) do
			for channel in table.clone(channels) do self:Cancel(instance, channel, true) end
		end
	end
end
function Animator:Destroy()
	if not self.alive then return end
	for instance in table.clone(self.active) do self:Forget(instance) end
	self.alive = false
end
return Animator

end
-- END animation/Animator

-- BEGIN config/Config
__modules["config/Config"] = function(__require)
--!nonstrict
local Signal=__require("core/Signal")
local Config={}
Config.__index=Config
local function finite(n) return type(n)=="number" and n==n and n&gt;-math.huge and n&lt;math.huge end
local function transform(value,decode,depth,seen)
	depth=depth or 0; seen=seen or {}
	assert(depth&lt;=16,"Configuration nesting exceeds 16 levels")
	local kind=typeof(value)
	if kind=="Color3" and not decode then return {["$type"]="Color3",r=value.R,g=value.G,b=value.B} end
	if kind=="nil" or kind=="boolean" then return value end
	if kind=="number" then assert(finite(value),"Configuration numbers must be finite"); return value end
	if kind=="string" then assert(#value&lt;=65536,"Configuration string is too large"); return value end
	assert(kind=="table","Unsupported configuration type: "..kind)
	assert(not seen[value],"Cyclic configuration table"); seen[value]=true
	if decode and value["$type"]~=nil then
		assert(value["$type"]=="Color3" and finite(value.r) and finite(value.g) and finite(value.b),"Invalid tagged configuration value")
		for _,channel in {value.r,value.g,value.b} do assert(channel&gt;=0 and channel&lt;=1,"Invalid color channel") end
		seen[value]=nil; return Color3.new(value.r,value.g,value.b)
	end
	local output,count,hasNumber,hasString={ },0,false,false
	for key,child in value do
		count+=1; assert(count&lt;=4096,"Configuration table is too large")
		assert((type(key)=="string" and key~="$type") or (finite(key) and key&gt;=1 and key%1==0),"Configuration keys must be strings or array indexes")
		if type(key)=="number" then hasNumber=true else hasString=true end
		output[key]=transform(child,decode,depth+1,seen)
	end
	assert(not (hasNumber and hasString),"Mixed configuration tables cannot be serialized predictably")
	if hasNumber then for index=1,count do assert(value[index]~=nil,"Configuration arrays must be dense") end end
	seen[value]=nil; return output
end
local function copy(value) return transform(transform(value,false),true) end
local function compatible(default,value)
	if typeof(default)~=typeof(value) then return false,"Expected "..typeof(default) end
	if type(default)=="table" then
		if #default&gt;0 then
			for _,child in value do if typeof(child)~=typeof(default[1]) then return false,"Array item type changed" end end
		end
	end
	return true
end
function Config.new(http,capabilities,options)
	options=options or {}
	return setmetatable({http=http,capabilities=capabilities or {},entries={},memory={},migrations={},version=options.version or 1,folder=options.folder or "MattLib"},Config)
end
function Config:Register(id,signal,default,validate)
	assert(type(id)=="string" and #id&gt;0 and #id&lt;=128 and not self.entries[id],"Configuration ids must be nonempty and unique")
	assert(Signal.is(signal),"Config:Register requires a signal")
	assert(default~=nil,"Configuration defaults cannot be nil")
	local entry={signal=signal,default=copy(default),validate=validate}
	self.entries[id]=entry
	return function() if self.entries[id]==entry then self.entries[id]=nil end end
end
function Config:RegisterMigration(fromVersion,migrate)
	assert(type(fromVersion)=="number" and fromVersion%1==0 and type(migrate)=="function","Invalid migration")
	self.migrations[fromVersion]=migrate
end
function Config:Export()
	local ok,result=pcall(function()
		local values={}
		for id,entry in self.entries do
			local current=entry.signal:get()
			local valid,reason=compatible(entry.default,current); assert(valid,"Invalid "..id..": "..tostring(reason))
			if entry.validate then valid,reason=entry.validate(current); assert(valid,"Invalid "..id..": "..tostring(reason or "validation failed")) end
			values[id]=transform(current,false)
		end
		return self.http:JSONEncode({schema="mattlib/config",version=self.version,values=values})
	end)
	if ok then return result end
	return nil,tostring(result)
end
function Config:Import(json,options)
	local ok,result=pcall(function()
		assert(type(json)=="string" and #json&lt;=1048576,"Configuration must be a JSON string under 1 MiB")
		local data=self.http:JSONDecode(json)
		assert(type(data)=="table" and data.schema=="mattlib/config" and type(data.version)=="number" and data.version%1==0,"Invalid configuration schema")
		assert(data.version&gt;=1 and data.version&lt;=self.version,"Unsupported configuration version")
		while data.version&lt;self.version do
			local migrate=self.migrations[data.version]
			assert(migrate,"Missing configuration migration")
			local previous=data.version
			data=migrate(data)
			assert(type(data)=="table" and data.version==previous+1,"Migration must advance exactly one version")
		end
		assert(type(data.values)=="table","Missing configuration values")
		local updates={}
		for id,encoded in data.values do
			local entry=self.entries[id]
			if not entry then assert(not (options and options.strict),"Unknown configuration id: "..tostring(id))
			else
				local value=transform(encoded,true)
				local valid,reason=compatible(entry.default,value)
				assert(valid,"Invalid "..id..": "..tostring(reason))
				if entry.validate then valid,reason=entry.validate(value); assert(valid,"Invalid "..id..": "..tostring(reason or "validation failed")) end
				table.insert(updates,{signal=entry.signal,value=value})
			end
		end
		Signal.batch(function() for _,update in updates do update.signal:set(update.value) end end)
		return true
	end)
	if ok then return result end
	return false,tostring(result)
end
function Config:Reset()
	Signal.batch(function() for _,entry in self.entries do entry.signal:set(copy(entry.default)) end end)
end
function Config:_path(name)
	assert(type(name)=="string" and #name&gt;0 and #name&lt;=64 and string.match(name,"^[%w_-]+$"),"Profile names use only letters, numbers, _ and -")
	assert(not string.find(self.folder,"..",1,true) and not string.match(self.folder,"^[/\\]") and not string.find(self.folder,":",1,true),"Configuration folder must be a relative path")
	return self.folder.."/"..name..".json"
end
function Config:Save(name)
	local json,err=self:Export(); if not json then return false,err end
	local ok,result=pcall(function()
		local path=self:_path(name)
		if not self.capabilities.writefile then self.memory[path]=json; return "memory" end
		if self.capabilities.makefolder and (not self.capabilities.isfolder or not self.capabilities.isfolder(self.folder)) then self.capabilities.makefolder(self.folder) end
		self.capabilities.writefile(path,json); self.memory[path]=json; return "file"
	end)
	return ok,if ok then result else tostring(result)
end
function Config:Load(name)
	local ok,result=pcall(function()
		local path=self:_path(name)
		if self.memory[path] and not self.capabilities.writefile then return self.memory[path] end
		if self.capabilities.readfile then
			if self.capabilities.isfile then assert(self.capabilities.isfile(path),"Configuration profile does not exist") end
			return self.capabilities.readfile(path)
		end
		assert(self.memory[path],"Configuration profile does not exist")
		return self.memory[path]
	end)
	if not ok then return false,tostring(result) end
	return self:Import(result)
end
function Config:Destroy() table.clear(self.entries); table.clear(self.memory) end
return Config

end
-- END config/Config

-- BEGIN feedback/Notifications
__modules["feedback/Notifications"] = function(__require)
--!nonstrict
local Signal=__require("core/Signal")
local Scope=__require("utils/Scope")
local Notifications={}
Notifications.__index=Notifications
function Notifications.new(theme,animator)
	return setmetatable({signal=Signal.new({}),records={},serial=0,theme=theme,animator=animator},Notifications)
end
function Notifications:_publish()
	local items={}
	for _,record in self.records do table.insert(items,{id=record.id,options=table.clone(record.options),closing=record.closing}) end
	table.sort(items,function(a,b) return a.id&lt;b.id end)
	self.signal:set(items)
end
function Notifications:_remove(id)
	local record=self.records[id]
	if not record then return end
	record.scope:Destroy(); self.records[id]=nil; self:_publish()
end
function Notifications:Dismiss(id)
	local record=self.records[id]
	if not record or record.closing then return end
	record.closing=true; self:_publish()
	if self.animator.reducedMotion then self:_remove(id)
	else record.scope:Delay(self.theme:Get().motion.normal,function() self:_remove(id) end) end
end
function Notifications:Push(options)
	options=options or {}
	local duration=if options.duration==nil then 5 else options.duration
	assert(duration==false or (type(duration)=="number" and duration&gt;=0 and duration&lt;math.huge),"Notification duration must be finite or false")
	self.serial+=1
	local id=self.serial
	local record={id=id,options=table.clone(options),scope=Scope.new(),closing=false}
	self.records[id]=record
	if duration~=false then record.scope:Delay(duration,function() self:Dismiss(id) end) end
	-- Bounded history keeps long-running notification producers from growing the tree indefinitely.
	local ids={}; for recordId in self.records do table.insert(ids,recordId) end; table.sort(ids)
	if #ids&gt;8 then self:_remove(ids[1]) end
	self:_publish()
	local service=self
	return {id=id,Dismiss=function() service:Dismiss(id) end,Destroy=function() service:_remove(id) end,
		Update=function(_,patch)
			if not service.records[id] then return end
			for key,value in patch do record.options[key]=value end
			service:_publish()
		end}
end
function Notifications:Destroy()
	for _,record in self.records do record.scope:Destroy() end
	table.clear(self.records); self.signal:Destroy()
end
return Notifications

end
-- END feedback/Notifications

-- BEGIN components/primitives/Primitives
__modules["components/primitives/Primitives"] = function(__require)
--!nonstrict
local Element = __require("core/Element")
local Style = __require("styling/StyleResolver")
local h = Element.h
local Primitives = {}
local textStyle = {backgroundTransparency=1,color="$text",font="$typography.font",textSize="$typography.body",
	textAlign="left",textYAlign="center",width="100%",height="auto",wrapped=true}
local function hostProps(p, defaults, native)
	return {name=p.name,ref=p.ref,style=Style.merge(defaults,p.style),native=Style.merge(native,p.native),
		events=p.events,changes=p.changes,attributes=p.attributes,disabled=p.disabled,active=p.active,motion=p.motion,
		role=p.role,accessibleName=p.accessibleName,accessibleValue=p.accessibleValue}
end
function Primitives.Frame(p)
	return h("@Frame",hostProps(p,{width="100%",height="auto",backgroundTransparency=1}),p.children)
end
Primitives.Container = Primitives.Frame
function Primitives.Column(p)
	return h("@Frame",hostProps(p,{width="100%",height="auto",backgroundTransparency=1,direction="column",gap="$spacing.sm"}),p.children)
end
function Primitives.Row(p)
	return h("@Frame",hostProps(p,{width="100%",height="auto",backgroundTransparency=1,direction="row",gap="$spacing.sm",verticalAlign="center"}),p.children)
end
Primitives.Stack = Primitives.Frame
function Primitives.Inset(p)
	return h(Primitives.Column,{name=p.name,ref=p.ref,style=Style.merge({padding=p.spacing or "$spacing.lg"},p.style)},p.children)
end
function Primitives.Text(p)
	return h("@TextLabel",hostProps(p,textStyle,{Text=tostring(p.text or ""),TextTruncate=Enum.TextTruncate.None}),p.children)
end
Primitives.Label = Primitives.Text
function Primitives.RichText(p)
	local copy = table.clone(p)
	copy.style = Style.merge({richText=true},p.style)
	return h(Primitives.Text,copy)
end
function Primitives.Paragraph(p)
	return h(Primitives.Text,{text=p.text or p.content,name=p.name,style=Style.merge({color="$muted",wrapped=true,textYAlign="top"},p.style)})
end
function Primitives.Icon(p)
	local size = p.size or 20
	if p.image then
		local image = if type(p.image) == "number" then "rbxassetid://" .. p.image else p.image
		return h("@ImageLabel",hostProps(p,{width=size,height=size,backgroundTransparency=1,imageColor="$text"},{Image=image,ScaleType=Enum.ScaleType.Fit}))
	end
	return h(Primitives.Text,{name=p.name,text=p.glyph or "◇",style=Style.merge({width=size,height=size,textSize=size,textAlign="center"},p.style)})
end
function Primitives.Separator(p)
	return h(Primitives.Frame,{name=p.name,style=Style.merge({width="100%",height=1,background="$border",backgroundTransparency=0},p.style)})
end
local variants = {
	primary={background="$accent",color="$accentText",hover={background="$accentHover"},pressed={background="$accentPressed"}},
	secondary={background="$raised",color="$text",borderWidth=1,borderColor="$border",hover={background="$hover"},pressed={background="$pressed"}},
	ghost={backgroundTransparency=1,color="$muted",hover={background="$hover",backgroundTransparency=0,color="$text"},pressed={background="$pressed",backgroundTransparency=0}},
	danger={background="$danger",color="$background",hover={opacity=0.85},pressed={opacity=0.7}},
}
function Primitives.Button(p)
	assert(variants[p.variant or "secondary"], "Unknown button variant")
	local props = hostProps(p,Style.merge(textStyle,{width="100%",height="$controlHeight",radius="$radius.md",backgroundTransparency=0,
		textAlign="center",wrapped=false,paddingX="$spacing.md",focus={borderWidth=2,borderColor="$accent"},
		disabled={color="$disabled",background="$input",backgroundTransparency=0,borderColor="$border"}},variants[p.variant or "secondary"]),
		{Text=tostring(p.text or p.label or ""),TextTruncate=Enum.TextTruncate.AtEnd})
	props.events = Style.merge(p.events,{Activated=function(instance,...)
		if not p.disabled and p.onClick then p.onClick(instance,...) end
	end})
	props.role, props.accessibleName = p.role or "button", p.accessibleName or p.text or p.label
	return h("@TextButton",props,p.children)
end
function Primitives.Badge(p)
	return h(Primitives.Text,{name=p.name,text=p.text,style=Style.merge({width="auto",height=24,paddingX="$spacing.sm",radius="$radius.sm",
		background="$raised",backgroundTransparency=0,color="$muted",textSize="$typography.small",textAlign="center",wrapped=false},p.style)})
end
function Primitives.ScrollArea(p)
	return h("@ScrollingFrame",hostProps(p,{width="100%",height="100%",backgroundTransparency=1,overflow="scroll",scrollbarColor="$border"},
		{CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=4,
		ScrollingDirection=Enum.ScrollingDirection.Y,ElasticBehavior=Enum.ElasticBehavior.WhenScrollable}),{
		h(Primitives.Column,{ref=p.contentRef,style=Style.merge({width=UDim.new(1,-8),padding={0,0,4,0}},p.contentStyle)},p.children),
	})
end
-- Padding is represented by the shared padding vocabulary, not native CSS keys.
function Primitives.register()
	for _, name in {"Frame","Container","Row","Column","Stack","Inset","Text","Label","RichText","Paragraph","Icon","Separator","Button","Badge","ScrollArea"} do
		Element.register(name,Primitives[name])
	end
end
Primitives.hostProps = hostProps
Primitives.textStyle = textStyle
return Primitives

end
-- END components/primitives/Primitives

-- BEGIN components/Common
__modules["components/Common"] = function(__require)
--!nonstrict
local Hooks = __require("core/Hooks")
local Scope = __require("utils/Scope")
local Common = {}
function Common.latest(value)
	local ref = Hooks.useRef(value)
	ref.current = value
	return ref
end
function Common.controllable(props, fallback, valueName, callbackName, defaultName)
	valueName, callbackName, defaultName = valueName or "value", callbackName or "onChange", defaultName or "defaultValue"
	local controlled = props[valueName] ~= nil
	local mode = Hooks.useRef(controlled)
	assert(mode.current == controlled, "A control cannot switch between controlled and uncontrolled modes")
	local internal, setInternal = Hooks.useState(function() return if props[defaultName] ~= nil then props[defaultName] else fallback end)
	local _, force = Hooks.useState(0)
	local value = if controlled then props[valueName] else internal
	local function update(nextValue)
		if props.disabled then return end
		if not controlled then setInternal(nextValue) end
		force(function(n) return n + 1 end)
		if props[callbackName] and value ~= nextValue then props[callbackName](nextValue) end
	end
	return value, update
end
function Common.scope()
	local scope = Hooks.useMemo(Scope.new, {})
	Hooks.useEffect(function() return function() scope:Destroy() end end, {})
	return scope
end
function Common.presence(open)
	local env = Hooks.useEnvironment()
	local present, setPresent = Hooks.useState(open)
	Hooks.useEffect(function()
		if open then setPresent(true); return end
		if env.animator.reducedMotion then setPresent(false); return end
		local scope = Scope.new()
		scope:Delay(env.theme:Get().motion.normal, function() setPresent(false) end)
		return function() scope:Destroy() end
	end, {open})
	return present or open
end
function Common.key(ref, callback, descendants)
	local env = Hooks.useEnvironment()
	local latest = Common.latest(callback)
	Hooks.useEffect(function()
		return env.input:OnKey(ref, function(...) return latest.current(...) end, descendants)
	end, {ref, descendants})
end
function Common.finite(value)
	return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
function Common.options(options)
	assert(type(options) == "table", "options must be an array")
	local count=0
	for key in options do assert(type(key)=="number" and key&gt;=1 and key%1==0,"options must be a dense array"); count+=1 end
	assert(count==#options,"options must be a dense array")
	local result, seen = {}, {}
	for index, option in options do
		local item = if type(option) == "table" then table.clone(option) else {value=option,label=tostring(option)}
		assert(type(item.value) == "string" or Common.finite(item.value), "Option values must be strings or finite numbers")
		local key = type(item.value) .. ":" .. tostring(item.value)
		assert(not seen[key], "Duplicate option value: " .. tostring(item.value))
		seen[key] = true
		item.label, item.key, item.index = item.label or tostring(item.value), key, index
		result[index] = item
	end
	return result
end
function Common.label(options, value)
	for _, item in options do if item.value == value then return item.label end end
	return nil
end
return Common

end
-- END components/Common

-- BEGIN components/layout/Sections
__modules["components/layout/Sections"] = function(__require)
--!nonstrict
local Element = __require("core/Element")
local Hooks = __require("core/Hooks")
local Style = __require("styling/StyleResolver")
local Scope = __require("utils/Scope")
local Common = __require("components/Common")
local h = Element.h
local Sections = {}
function Sections.Section(p)
	return h("Column",{name=p.name,style=Style.merge({background="$surface",backgroundTransparency=0,borderWidth=1,borderColor="$border",
		radius="$radius.lg",padding="$spacing.lg",gap="$spacing.md"},p.style)}, {
		p.title and h("Text",{text=p.title,style={font="$typography.medium",textSize=15}}) or false,
		p.description and h("Paragraph",{text=p.description}) or false,
		p.children,
	})
end
function Sections.Collapsible(p)
	local open, setOpen = Common.controllable(p,false,"open","onOpenChange","defaultOpen")
	local env = Hooks.useEnvironment()
	local content, body = Hooks.useRef(nil), Hooks.useRef(nil)
	local height,setHeight = Hooks.useState(0)
	Hooks.useEffect(function()
		local scope = Scope.new()
		local function measure() setHeight(content.current.AbsoluteSize.Y) end
		scope:Connect(content.current:GetPropertyChangedSignal("AbsoluteSize"),measure)
		measure()
		return function() scope:Destroy() end
	end,{})
	Hooks.useEffect(function()
		return env.animator:To(body.current,{Size=UDim2.new(1,0,0,if open then height else 0)},env.theme:Get().motion.normal)
	end,{open,height})
	return h("Section",{name=p.name,style=p.style},{
		h("Button",{text=(if open then "▾  " else "▸  ") .. (p.title or "Section"),variant="ghost",disabled=p.disabled,
			style={textAlign="left"},onClick=function() setOpen(not open) end,accessibleName=(p.title or "Section") .. (if open then ", expanded" else ", collapsed")}),
		h("Frame",{ref=body,style={height=0,overflow="hidden"}}, {
			h("Column",{ref=content,style={paddingY="$spacing.sm"}},p.children),
		}),
	})
end
return Sections

end
-- END components/layout/Sections

-- BEGIN components/layout/Overlays
__modules["components/layout/Overlays"] = function(__require)
--!nonstrict
local Element = __require("core/Element")
local Hooks = __require("core/Hooks")
local Style = __require("styling/StyleResolver")
local Scope = __require("utils/Scope")
local Common = __require("components/Common")
local h = Element.h
local Overlays = {}
local function fade(ref, open, present)
	local env=Hooks.useEnvironment()
	local mounted=Hooks.useRef(false)
	Hooks.useEffect(function()
		if not present or not ref.current then mounted.current=false; return end
		if not mounted.current then ref.current.GroupTransparency=1; mounted.current=true end
		return env.animator:To(ref.current,{GroupTransparency=if open then 0 else 1},env.theme:Get().motion.normal)
	end,{open,present})
end
function Overlays.Modal(p)
	local open,setOpen=Common.controllable(p,true,"open","onOpenChange","defaultOpen")
	local present=Common.presence(open)
	local env=Hooks.useEnvironment()
	local group,panel=Hooks.useRef(nil),Hooks.useRef(nil)
	local viewport=Hooks.useSignal(env.runtime.viewport)
	local content=Hooks.useRef(nil)
	local contentHeight,setContentHeight=Hooks.useState(120)
	local latest=Common.latest(function() if p.dismissible~=false then setOpen(false) end end)
	local z=Hooks.useMemo(function() return env.overlays:NextZ() end,{})
	fade(group,open,present)
	Hooks.useEffect(function()
		if not present then return end
		local scope=Scope.new()
		local function measure() if content.current then setContentHeight(content.current.AbsoluteSize.Y) end end
		scope:Connect(content.current:GetPropertyChangedSignal("AbsoluteSize"),measure); measure()
		return function() scope:Destroy() end
	end,{present})
	Hooks.useEffect(function()
		if not present or not open then return end
		return env.overlays:Attach(panel.current,function() latest.current() end,true,nil,z)
	end,{present,open})
	if not present then return nil end
	return Element.portal(h("@CanvasGroup",{ref=group,name=p.name or "Modal",style={width="100%",height="100%",zIndex=z}}, {
		h("@TextButton",{name="ModalBackdrop",native={Text="",Modal=true,Active=true},style={width="100%",height="100%",background="$overlay",backgroundTransparency=0.35},
			events={Activated=function() latest.current() end}}),
		h("Column",{ref=panel,style=Style.merge({width=UDim.new(1,-32),maxWidth=p.width or 440,height="auto",maxHeight=math.max(1,viewport.Y-16),
			position=UDim2.fromScale(0.5,0.5),anchor=Vector2.new(0.5,0.5),background="$surface",backgroundTransparency=0,
			borderWidth=1,borderColor="$border",radius="$radius.lg",padding="$spacing.xl",gap="$spacing.lg",zIndex=2},p.style)}, {
			p.title and h("Text",{text=p.title,style={textSize="$typography.title",font="$typography.bold"}}) or false,
			h("ScrollArea",{contentRef=content,style={height=math.max(1,math.min(contentHeight,viewport.Y-140))},contentStyle={gap=16}},p.children),
		}),
	}),env.runtime.layers.overlay)
end
function Overlays.Popover(p)
	local open,setOpen=Common.controllable(p,false,"open","onOpenChange","defaultOpen")
	local present=Common.presence(open)
	local env=Hooks.useEnvironment()
	local ownPanel=Hooks.useRef(nil)
	local panel=p.panelRef or ownPanel
	local content=Hooks.useRef(nil)
	local contentHeight,setContentHeight=Hooks.useState(32)
	local latest=Common.latest(function() setOpen(false) end)
	local z=Hooks.useMemo(function() return env.overlays:NextZ() end,{})
	local rect,setRect=Hooks.useState({x=16,y=16,width=p.width or 280,maxHeight=p.maxHeight or 320})
	local previous=Hooks.useRef(nil)
	Hooks.useEffect(function()
		if not present then return end
		local scope=Scope.new()
		local anchor=p.anchor and p.anchor.current
		local layer=env.runtime.layers.overlay
		local function position()
			local viewport,origin=layer.AbsoluteSize,layer.AbsolutePosition
			local width=math.max(1,math.min(p.width or (anchor and anchor.AbsoluteSize.X) or 280,viewport.X-16))
			local x,y,bottom=16,16,16
			if p.position then x,y=p.position.X-origin.X,p.position.Y-origin.Y; bottom=y
			elseif anchor then
				x,y=anchor.AbsolutePosition.X-origin.X,anchor.AbsolutePosition.Y-origin.Y
				bottom=y+anchor.AbsoluteSize.Y+6
			end
			local available=math.max(32,math.min(p.maxHeight or 320,viewport.Y-16))
			local actual=panel.current and panel.current.AbsoluteSize.Y or available
			local top=bottom
			if top+actual&gt;viewport.Y-8 then top=math.max(8,y-math.min(actual,available)-6) end
			local nextRect={x=math.clamp(x,8,math.max(8,viewport.X-width-8)),y=top,width=width,maxHeight=math.max(1,math.min(available,viewport.Y-top-8))}
			local old=previous.current
			if not old or old.x~=nextRect.x or old.y~=nextRect.y or old.width~=nextRect.width or old.maxHeight~=nextRect.maxHeight then
				previous.current=nextRect; setRect(nextRect)
			end
		end
		if anchor then
			scope:Connect(anchor:GetPropertyChangedSignal("AbsolutePosition"),position)
			scope:Connect(anchor:GetPropertyChangedSignal("AbsoluteSize"),position)
		end
		scope:Connect(layer:GetPropertyChangedSignal("AbsoluteSize"),position)
		if panel.current then scope:Connect(panel.current:GetPropertyChangedSignal("AbsoluteSize"),position) end
		position()
		return function() scope:Destroy() end
	end,{present,p.width,p.maxHeight,p.position,p.anchor})
	fade(panel,open,present)
	Hooks.useEffect(function()
		if not present or p.scrollable==false then return end
		local scope=Scope.new()
		local function measure() if content.current then setContentHeight(content.current.AbsoluteSize.Y) end end
		scope:Connect(content.current:GetPropertyChangedSignal("AbsoluteSize"),measure); measure()
		return function() scope:Destroy() end
	end,{present,p.scrollable})
	Hooks.useEffect(function()
		if not present or not open then return end
		return env.overlays:Attach(panel.current,function() latest.current() end,false,p.anchor and p.anchor.current,z)
	end,{present,open,p.anchor})
	if not present then return nil end
	return Element.portal(h("@CanvasGroup",{ref=panel,name=p.name or "Popover",style=Style.merge({width=rect.width,height=if p.scrollable==false then "auto" else math.max(1,math.min(contentHeight,rect.maxHeight-16))+16,maxHeight=rect.maxHeight,
		position=UDim2.fromOffset(rect.x,rect.y),background="$raised",backgroundTransparency=0,borderWidth=1,borderColor="$border",
		radius="$radius.md",padding="$spacing.sm",direction="column",gap="$spacing.xs",zIndex=z,overflow="hidden"},p.style)},
		if p.scrollable==false then p.children else {h("ScrollArea",{contentRef=content,style={height=math.max(1,math.min(contentHeight,rect.maxHeight-16))},contentStyle={gap=4}},p.children)}),env.runtime.layers.overlay)
end
function Overlays.ConfirmationDialog(p)
	local open,setOpen=Common.controllable(p,true,"open","onOpenChange","defaultOpen")
	local answered=Hooks.useRef(false)
	Hooks.useEffect(function() if open then answered.current=false end end,{open})
	local function answer(value)
		if answered.current then return end
		answered.current=true; setOpen(false)
		if p.onResult then p.onResult(value) end
	end
	return h(Overlays.Modal,{name=p.name,title=p.title or "Confirm action",open=open,onOpenChange=function(nextOpen)
		if not nextOpen then answer(false) end
	end,dismissible=p.dismissible,width=p.width}, {
		h("Paragraph",{text=p.message or "Continue with this action?"}),
		h("Row",{style={distribute="fill"}}, {
			h("Button",{text=p.cancelText or "Cancel",onClick=function() answer(false) end}),
			h("Button",{text=p.confirmText or "Confirm",variant=p.danger and "danger" or "primary",onClick=function() answer(true) end}),
		}),
	})
end
function Overlays.ContextMenu(p)
	local open,setOpen=Hooks.useState(false)
	local point,setPoint=Hooks.useState(Vector2.new())
	return h(Element.Fragment,{}, {
		h("Frame",{name=p.name,style=p.style,events={InputBegan=function(_,input)
			if input.UserInputType==Enum.UserInputType.MouseButton2 and not p.disabled then setPoint(Vector2.new(input.Position.X,input.Position.Y)); setOpen(true) end
		end,TouchLongPress=function(_,positions,state)
			if state==Enum.UserInputState.End and positions[1] and not p.disabled then setPoint(positions[1]); setOpen(true) end
		end}},p.children),
		h(Overlays.Popover,{open=open,onOpenChange=setOpen,position=point,width=p.width or 220},
			Element.list(p.items or {},function(item)
				return h("Button",{text=item.label,disabled=item.disabled,variant="ghost",style={textAlign="left"},onClick=function()
					setOpen(false); if item.onSelect then item.onSelect() end
				end})
			end,function(item) return item.id or item.label end)),
	})
end
return Overlays

end
-- END components/layout/Overlays

-- BEGIN components/layout/Window
__modules["components/layout/Window"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Theme=__require("styling/Theme")
local Common=__require("components/Common")
local Style=__require("styling/StyleResolver")
local h=Element.h
local Window={}
local serial=0
function Window.ThemeProvider(p)
	local service=Hooks.useMemo(function() return if type(p.theme)=="table" and p.theme.signal then p.theme else Theme.new(p.theme or "Dark") end,{p.theme})
	Hooks.useEffect(function() return function() if service~=p.theme then service:Destroy() end end end,{service})
	return h(Element.Provider,{service=service},p.children)
end
local function WindowBase(p)
	local env=Hooks.useEnvironment()
	local frame,title,grip,handle=Hooks.useRef(nil),Hooks.useRef(nil),Hooks.useRef(nil),Hooks.useRef(nil)
	local visible,setVisible=Hooks.useState(p.defaultVisible~=false)
	local minimized,setMinimized=Hooks.useState(false)
	local closed,setClosed=Hooks.useState(false)
	local present=Common.presence(not closed)
	local id=Hooks.useMemo(function() serial+=1; return p.id or "window-"..serial end,{p.id})
	local latest=Common.latest(p)
	Hooks.useEffect(function()
		if not present then return end
		local entry=env.windows:Register({id=id,title=p.title,frame=frame.current,titlebar=title.current,grip=grip.current,size=p.size or {720,500},
			position=p.position,minSize=p.minSize,maxSize=p.maxSize,fixedSize=p.fixedSize,openKey=p.openKey,visible=visible,
			onVisible=function(show) setVisible(show); if latest.current.onVisibleChange then latest.current.onVisibleChange(show) end end,
			onMinimized=setMinimized,onMove=p.onMove,onResize=p.onResize,onClose=function()
				setClosed(true); if latest.current.onClose then latest.current.onClose() end
			end})
		handle.current=entry
		if p.windowRef then p.windowRef.current=entry end
		if p.onReady then
			local ok,err=pcall(p.onReady,entry)
			if not ok then entry:Detach(); if p.windowRef then p.windowRef.current=nil end; error(err,0) end
		end
		frame.current.GroupTransparency=1
		env.animator:To(frame.current,{GroupTransparency=0},env.theme:Get().motion.normal)
		return function() entry:Detach(); handle.current=nil; if p.windowRef then p.windowRef.current=nil end end
	end,{id,present})
	Hooks.useEffect(function()
		if closed and frame.current then return env.animator:To(frame.current,{GroupTransparency=1},env.theme:Get().motion.normal) end
	end,{closed})
	if not present then return nil end
	return h("@CanvasGroup",{ref=frame,name=p.name or "Window:"..id,role="window",accessibleName=p.title or "Application",native={Active=true},
		style=Style.merge({width=(p.size or {720,500})[1],height=(p.size or {720,500})[2],background="$background",backgroundTransparency=0,
			borderWidth=1,borderColor="$border",radius="$radius.lg",overflow="hidden",visible=visible},p.style)}, {
		h("Frame",{ref=title,name="WindowTitlebar",native={Active=true,Selectable=true},accessibleName="Move window with arrow keys",
			style={width="100%",height=44,background="$surface",backgroundTransparency=0}}, {
			h("Text",{text=p.title or "Application",style={position=UDim2.fromOffset(16,0),width=UDim.new(1,-142),height=44,font="$typography.medium",wrapped=false},native={TextTruncate=Enum.TextTruncate.AtEnd}}),
			h("Button",{name="WindowMinimize",text=if minimized then "▢" else "−",variant="ghost",accessibleName=if minimized then "Restore window" else "Minimize window",
				style={width=34,height=30,position=UDim2.new(1,-114,0,7)},onClick=function() if handle.current then if minimized then handle.current:Restore() else handle.current:Minimize() end end end}),
			h("Button",{name="WindowHide",text="⌄",variant="ghost",accessibleName="Hide window",style={width=34,height=30,position=UDim2.new(1,-78,0,7)},
				onClick=function() if handle.current then handle.current:Hide() end end}),
			h("Button",{name="WindowClose",text="×",variant="ghost",accessibleName="Close window",style={width=34,height=30,position=UDim2.new(1,-42,0,7),hover={color="$danger",background="$hover"}},
				onClick=function() if handle.current then handle.current:Close() end end}),
		}),
		h("Separator",{style={position=UDim2.fromOffset(0,44)}}),
		h("Frame",{name="WindowContent",style={width="100%",height=UDim.new(1,-45),position=UDim2.fromOffset(0,45),visible=not minimized}},p.children),
		h("Button",{ref=grip,name="WindowResize",text="◢",variant="ghost",accessibleName="Resize window with arrow keys",
			style={width=28,height=28,position=UDim2.new(1,-28,1,-28),visible=not p.fixedSize and not minimized,textSize=12,paddingX=0,zIndex=5}}),
	})
end
function Window.Window(p)
	local env=Hooks.useEnvironment()
	return h(Window.ThemeProvider,{theme=p.theme or env.theme},h(WindowBase,p))
end
function Window.RecoveryHost()
	local env=Hooks.useEnvironment()
	local hidden=Hooks.useSignal(env.windows.hidden)
	local viewport=Hooks.useSignal(env.runtime.viewport)
	if #hidden==0 then return nil end
	return h("Frame",{name="RestoreWindows",style={width=170,height=math.min(#hidden*44,math.max(44,viewport.Y-16)),position=UDim2.new(0,8,1,-8),anchor=Vector2.new(0,1),zIndex=1000000}}, {
		h("ScrollArea",{contentStyle={gap=6}},Element.list(hidden,function(entry)
			return h("Button",{text="↗  "..(entry.options.title or entry.id),onClick=function() entry:Restore() end,accessibleName="Restore "..(entry.options.title or entry.id)})
		end,function(entry) return entry.id end)),
	})
end
return Window

end
-- END components/layout/Window

-- BEGIN components/navigation/Tabs
__modules["components/navigation/Tabs"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Common=__require("components/Common")
local Style=__require("styling/StyleResolver")
local h=Element.h
local Tabs={}
local function Panel(p)
	local env=Hooks.useEnvironment()
	local ref=Hooks.useRef(nil)
	Hooks.useEffect(function()
		if p.active then
			ref.current.GroupTransparency=0.2
			return env.animator:To(ref.current,{GroupTransparency=0},env.theme:Get().motion.fast)
		end
	end,{p.active})
	return h("@CanvasGroup",{ref=ref,style={width="100%",height="100%",visible=p.active}},p.children)
end
function Tabs.Tab() error("Tab must be a direct child of Tabs or Sidebar",2) end
function Tabs.Tabs(p)
	local items=p.items
	if not items then
		items={}
		for _,child in p.children do
			assert(child.type=="Tab" or child.type==Tabs.Tab,"Tabs children must be Tab elements")
			local props=child.props
			table.insert(items,{id=props.id or props.title,title=props.title,disabled=props.disabled,content=props.children})
		end
	end
	local seen={}
	for _,item in items do assert(item.id~=nil and not seen[item.id],"Tab ids must be unique"); seen[item.id]=true end
	local value,setValue=Common.controllable(p,items[1] and items[1].id)
	local env=Hooks.useEnvironment()
	local viewport=Hooks.useSignal(env.runtime.viewport)
	local sidebar=(p.orientation=="sidebar") and viewport.X&gt;=600
	local selected=value
	if not seen[selected] then selected=items[1] and items[1].id end
	local navigation=Element.list(items,function(item)
		return h("Button",{name="Tab:"..tostring(item.id),text=item.title or tostring(item.id),disabled=item.disabled,variant="ghost",active=selected==item.id,
			style={width=if sidebar then "100%" else p.tabWidth or 120,height=38,textAlign=if sidebar then "left" else "center",
				active={background="$hover",backgroundTransparency=0,color="$accent"}},
			onClick=function() setValue(item.id) end,accessibleName=(item.title or tostring(item.id))..(if selected==item.id then ", selected tab" else ", tab")})
	end,function(item) return item.id end)
	local panels=Element.list(items,function(item)
		return h(Panel,{active=selected==item.id},if p.unmountInactive and selected~=item.id then {} else {
			h("ScrollArea",{contentStyle={padding=p.padding or 16,gap=16}},item.content or {}),
		})
	end,function(item) return item.id end)
	return h("Frame",{name=p.name,style=Style.merge({width="100%",height="100%"},p.style)}, {
		h("ScrollArea",{name="TabNavigation",style={width=if sidebar then p.sidebarWidth or 168 else "100%",height=if sidebar then "100%" else 44},
			contentStyle={direction=if sidebar then "column" else "row",gap=4,padding=4},
			native={AutomaticCanvasSize=if sidebar then Enum.AutomaticSize.Y else Enum.AutomaticSize.X,
				ScrollingDirection=if sidebar then Enum.ScrollingDirection.Y else Enum.ScrollingDirection.X}},navigation),
		h("Frame",{name="TabPanels",style={width=if sidebar then UDim.new(1,-(p.sidebarWidth or 168)-8) else "100%",height=if sidebar then "100%" else UDim.new(1,-48),
			position=if sidebar then UDim2.fromOffset((p.sidebarWidth or 168)+8,0) else UDim2.fromOffset(0,48)}},panels),
	})
end
function Tabs.Sidebar(p)
	local copy=table.clone(p); copy.orientation="sidebar"
	return h(Tabs.Tabs,copy)
end
return Tabs

end
-- END components/navigation/Tabs

-- BEGIN components/inputs/Boolean
__modules["components/inputs/Boolean"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Style=__require("styling/StyleResolver")
local Common=__require("components/Common")
local h=Element.h
local Boolean={}
local function control(p,kind)
	local value,setValue=Common.controllable(p,false)
	assert(type(value)=="boolean",kind.." value must be boolean")
	local checkbox=kind=="checkbox"
	return h("Button",{name=p.name,ref=p.ref,text="",disabled=p.disabled,variant="ghost",onClick=function() setValue(not value) end,
		role=kind,accessibleName=p.accessibleName or p.label or kind,accessibleValue=tostring(value),
		style=Style.merge({height=if p.description then 62 else 44,paddingX=8},p.style)}, {
		h("Column",{style={width=UDim.new(1,-64),height="auto",position=UDim2.new(0,0,0.5,0),anchor=Vector2.new(0,0.5),gap=2}}, {
			h("Text",{text=p.label or (if checkbox then "Checkbox" else "Toggle"),style={color=if p.disabled then "$disabled" else "$text"}}),
			p.description and h("Paragraph",{text=p.description,style={textSize=12}}) or false,
		}),
		h("Frame",{style={width=if checkbox then 22 else 40,height=22,position=UDim2.new(1,-4,0.5,0),anchor=Vector2.new(1,0.5),
			background=if p.disabled then "$disabled" elseif value then "$accent" else "$input",backgroundTransparency=0,
			radius=if checkbox then "$radius.sm" else "$radius.pill",borderWidth=1,borderColor=if value then "$accent" else "$border"}}, {
			if checkbox then h("Text",{text=if value then "✓" else "",style={width="100%",height="100%",textAlign="center",color="$accentText",textSize=18}})
			else h("Frame",{motion=true,style={width=16,height=16,position=UDim2.new(0,if value then 21 else 3,0.5,0),anchor=Vector2.new(0,0.5),
				background=if value then "$accentText" else "$muted",backgroundTransparency=0,radius="$radius.pill"}}),
		}),
	})
end
function Boolean.Toggle(p) return control(p,"switch") end
Boolean.Switch=Boolean.Toggle
function Boolean.Checkbox(p) return control(p,"checkbox") end
return Boolean

end
-- END components/inputs/Boolean

-- BEGIN components/inputs/TextInput
__modules["components/inputs/TextInput"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Style=__require("styling/StyleResolver")
local Common=__require("components/Common")
local h=Element.h
local Inputs={}
function Inputs.TextInput(p)
	local value,setValue=Common.controllable(p,"")
	assert(type(value)=="string","TextInput value must be a string")
	assert(p.maxLength==nil or (Common.finite(p.maxLength) and p.maxLength&gt;=0 and p.maxLength%1==0),"maxLength must be a nonnegative integer")
	local env=Hooks.useEnvironment()
	local theme=Hooks.useSignal(env.theme.signal)
	local props={name=p.name,ref=p.ref,disabled=p.disabled,role="textbox",accessibleName=p.accessibleName or p.label or p.placeholder,
		style=Style.merge({width="100%",height=if p.multiline then 94 else "$controlHeight",background="$input",backgroundTransparency=0,
			color="$text",font="$typography.font",textSize="$typography.body",textAlign="left",textYAlign=if p.multiline then "top" else "center",
			paddingX=12,paddingY=8,radius="$radius.md",borderWidth=1,borderColor="$border",focus={borderColor="$accent",borderWidth=2},
			disabled={color="$disabled"}},p.inputStyle),
		native={Text=value,PlaceholderText=p.placeholder or "",PlaceholderColor3=theme.subtle,ClearTextOnFocus=false,MultiLine=p.multiline or false,
			TextWrapped=p.multiline or false,Selectable=not p.disabled},
		changes={Text=function(instance)
			local text=instance.Text
			if p.maxLength then
				local length=utf8.len(text)
				if length and length&gt;p.maxLength then text=string.sub(text,1,utf8.offset(text,p.maxLength+1)-1) end
			end
			setValue(text)
		end},events={FocusLost=function(instance,enter)
			if p.onCommit then p.onCommit(instance.Text,enter) end
		end}}
	return h("Column",{style=Style.merge({gap=6},p.style)}, {
		p.label and h("Text",{text=p.label,style={textSize=13,font="$typography.medium"}}) or false,
		h("@TextBox",props),
		p.description and h("Paragraph",{text=p.description,style={textSize=12}}) or false,
	})
end
function Inputs.NumericInput(p)
	local value,setValue=Common.controllable(p,0)
	assert(Common.finite(value),"NumericInput value must be finite")
	local min,max=p.min or -math.huge,p.max or math.huge
	assert(min&lt;=max,"NumericInput min must not exceed max")
	local draft,setDraft=Hooks.useState(tostring(value))
	local errorText,setError=Hooks.useState("")
	Hooks.useEffect(function() setDraft(tostring(value)) end,{value})
	local function commit(text)
		local number=tonumber(text)
		if not Common.finite(number) then setDraft(tostring(value)); setError("Enter a valid number"); if p.onInvalid then p.onInvalid(text) end; return end
		number=math.clamp(number,min,max)
		if p.step then
			assert(Common.finite(p.step) and p.step&gt;0,"step must be positive")
			local base=if min&gt;-math.huge then min else 0
			number=math.clamp(base+math.round((number-base)/p.step)*p.step,min,max)
		end
		setDraft(tostring(if p.value~=nil then value else number)); setError(""); setValue(number)
		if p.onCommit then p.onCommit(number) end
	end
	return h("Column",{style=p.style}, {
		h(Inputs.TextInput,{name=p.name,ref=p.ref,label=p.label,placeholder=p.placeholder,disabled=p.disabled,value=draft,
			onChange=function(text) setDraft(text); setError("") end,onCommit=commit,inputStyle=p.inputStyle,description=p.description}),
		errorText~="" and h("Text",{text=errorText,style={color="$danger",textSize=12}}) or false,
	})
end
return Inputs

end
-- END components/inputs/TextInput

-- BEGIN components/inputs/Slider
__modules["components/inputs/Slider"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Style=__require("styling/StyleResolver")
local Input=__require("runtime/Input")
local Common=__require("components/Common")
local h=Element.h
local Sliders={}
function Sliders.quantize(value,min,max,step)
	return math.clamp(min+math.round((value-min)/step)*step,min,max)
end
local function slider(p,range)
	local min,max,step=p.min or 0,p.max or 100,p.step or 1
	assert(Common.finite(min) and Common.finite(max) and max&gt;min,"Slider requires finite min &lt; max")
	assert(Common.finite(step) and step&gt;0,"Slider step must be positive")
	local value,setValue=Common.controllable(p,if range then {min,max} else min)
	if range then assert(type(value)=="table" and Common.finite(value[1]) and Common.finite(value[2]) and value[1]&lt;=value[2],"RangeSlider requires {low, high}")
	else assert(Common.finite(value),"Slider value must be finite") end
	local low=math.clamp(if range then value[1] else min,min,max)
	local high=math.clamp(if range then value[2] else value,min,max)
	local env=Hooks.useEnvironment()
	local track=Hooks.useRef(nil)
	local active=Hooks.useRef(1)
	local latest=Common.latest({value=value,low=low,high=high,setValue=setValue,props=p})
	local capture=Hooks.useRef(nil)
	local function update(number,index)
		local state=latest.current
		number=Sliders.quantize(number,min,max,step)
		if range then
			local nextValue=if index==1 then {math.min(number,state.high),state.high} else {state.low,math.max(number,state.low)}
			state.low,state.high=nextValue[1],nextValue[2]
			if nextValue[1]~=state.value[1] or nextValue[2]~=state.value[2] then state.value=nextValue; state.setValue(nextValue) end
		else
			if state.value~=number then state.value=number; state.high=number; state.setValue(number) end
		end
	end
	local function fromPointer(position)
		local instance=track.current
		return min+math.clamp((position.X-instance.AbsolutePosition.X)/math.max(1,instance.AbsoluteSize.X),0,1)*(max-min)
	end
	Common.key(track,function(key)
		if p.disabled then return end
		if range and key==Enum.KeyCode.Space then active.current=if active.current==1 then 2 else 1; return true end
		local current=if range and active.current==1 then latest.current.low else latest.current.high
		if key==Enum.KeyCode.Left or key==Enum.KeyCode.Down then update(current-step,active.current)
		elseif key==Enum.KeyCode.Right or key==Enum.KeyCode.Up then update(current+step,active.current)
		elseif key==Enum.KeyCode.Home then update(min,active.current)
		elseif key==Enum.KeyCode.End then update(max,active.current)
		else return end
		if p.onCommit then p.onCommit(latest.current.value) end
		return true
	end)
	Hooks.useEffect(function() return function() if capture.current then capture.current() end end end,{min,max,step,p.disabled})
	local function thumb(ratio,key)
		return h("Frame",{key=key,style={width=14,height=14,position=UDim2.fromScale(ratio,0.5),anchor=Vector2.new(0.5,0.5),
			background=if p.disabled then "$disabled" else "$text",backgroundTransparency=0,radius="$radius.pill",zIndex=3}})
	end
	local lowRatio,highRatio=(low-min)/(max-min),(high-min)/(max-min)
	local formatted=if p.format then p.format(value) elseif range then string.format("%g – %g",low,high) else string.format("%g",high)
	return h("Column",{name=p.name,style=Style.merge({gap=4,paddingX=8},p.style)}, {
		h("Row",{}, {
			h("Text",{text=p.label or (if range then "Range" else "Value"),style={width=UDim.new(1,-120),height=22}}),
			h("Text",{text=formatted,style={width=112,height=22,textAlign="right",color="$muted",textSize=12}}),
		}),
		h("@TextButton",{name=(p.name or (if range then "RangeSlider" else "Slider"))..":Track",ref=track,disabled=p.disabled,role=if range then "range slider" else "slider",
			accessibleName=p.accessibleName or p.label,accessibleValue=formatted,native={Text=""},
			style={width="100%",height=28,backgroundTransparency=1,focus={borderWidth=1,borderColor="$accent",radius=4}},
			events={InputBegan=function(_,input)
				if p.disabled or not Input.isPointer(input) then return end
				local number=fromPointer(input.Position)
				active.current=if range and math.abs(number-latest.current.high)&lt;math.abs(number-latest.current.low) then 2 else 1
				update(number,active.current)
				capture.current=env.input:Capture(input,function(position) update(fromPointer(position),active.current) end,function(cancelled)
					capture.current=nil
					if not cancelled and latest.current.props.onCommit then latest.current.props.onCommit(latest.current.value) end
				end)
			end}}, {
			h("Frame",{style={width="100%",height=5,position=UDim2.fromScale(0,0.5),anchor=Vector2.new(0,0.5),background="$input",backgroundTransparency=0,radius="$radius.pill"}}),
			h("Frame",{style={width=UDim.new(highRatio-lowRatio,0),height=5,position=UDim2.fromScale(lowRatio,0.5),anchor=Vector2.new(0,0.5),
				background=if p.disabled then "$disabled" else "$accent",backgroundTransparency=0,radius="$radius.pill",zIndex=2}}),
			if range then thumb(lowRatio,"low") else false,
			thumb(highRatio,"high"),
		}),
	})
end
function Sliders.Slider(p) return slider(p,false) end
function Sliders.RangeSlider(p) return slider(p,true) end
return Sliders

end
-- END components/inputs/Slider

-- BEGIN components/inputs/Dropdown
__modules["components/inputs/Dropdown"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Common=__require("components/Common")
local Style=__require("styling/StyleResolver")
local h=Element.h
local Dropdowns={}
function Dropdowns.Dropdown(p)
	local options=Hooks.useMemo(function() return Common.options(p.options or {}) end,{p.options})
	local multiple=p.multiple==true
	local value,setValue=Common.controllable(p,if multiple then {} else "")
	assert((multiple and type(value)=="table") or (not multiple and (type(value)=="string" or type(value)=="number")),"Invalid dropdown value")
	local open,setOpen=Hooks.useState(false)
	local query,setQuery=Hooks.useState("")
	local highlighted,setHighlighted=Hooks.useState(1)
	local anchor,search,panel=Hooks.useRef(nil),Hooks.useRef(nil),Hooks.useRef(nil)
	local env=Hooks.useEnvironment()
	local viewport=Hooks.useSignal(env.runtime.viewport)
	local filtered=Hooks.useMemo(function()
		local result={}
		for _,item in options do if string.find(string.lower(item.label),string.lower(query),1,true) then table.insert(result,item) end end
		return result
	end,{options,query})
	local latest=Common.latest(value)
	local function selected(option) return if multiple then table.find(value,option)~=nil else value==option end
	local function choose(item)
		if item.disabled or p.disabled then return end
		if multiple then
			local nextValue=table.clone(latest.current)
			local index=table.find(nextValue,item.value)
			if index then table.remove(nextValue,index) else table.insert(nextValue,item.value) end
			latest.current=nextValue; setValue(nextValue)
		else setValue(item.value); setOpen(false); env.input.guiService.SelectedObject=anchor.current end
	end
	local function toggle()
		if p.disabled then return end
		setOpen(not open); setHighlighted(1); setQuery("")
		env.input.guiService.SelectedObject=anchor.current
	end
	local function keyboard(key)
		if p.disabled then return end
		if key==Enum.KeyCode.Down or key==Enum.KeyCode.Up then
			if not open then toggle(); return true end
			local direction=if key==Enum.KeyCode.Down then 1 else -1
			local index=highlighted
			for _=1,#filtered do
				index=(index-1+direction)%#filtered+1
				if not filtered[index].disabled then setHighlighted(index); break end
			end
			return true
		elseif key==Enum.KeyCode.Return then
			if open then if filtered[highlighted] then choose(filtered[highlighted]) end else toggle() end
			return true
		elseif key==Enum.KeyCode.Escape and open then setOpen(false); return true end
	end
	Common.key(anchor,keyboard)
	Common.key(search,keyboard)
	Common.key(panel,keyboard,true)
	Hooks.useEffect(function()
		if open and search.current then search.current:CaptureFocus() end
	end,{open})
	Hooks.useEffect(function() if p.disabled then setOpen(false) end end,{p.disabled})
	local labels={}
	if multiple then for _,option in value do table.insert(labels,Common.label(options,option) or tostring(option)) end end
	local label=if multiple then (#labels&gt;0 and table.concat(labels,", ") or p.placeholder or "Select options")
		else Common.label(options,value) or p.placeholder or "Select an option"
	return h("Column",{name=p.name,style=Style.merge({gap=6},p.style)}, {
		p.label and h("Text",{text=p.label,style={textSize=13,font="$typography.medium"}}) or false,
		h("Button",{name=(p.name or "Dropdown")..":Trigger",ref=anchor,text=label.."   ▾",disabled=p.disabled,onClick=toggle,
			style={textAlign="left",background="$input"},role=multiple and "multiselect" or "combobox",accessibleName=p.accessibleName or p.label,accessibleValue=label}),
		h("Popover",{name=(p.name or "Dropdown")..":Menu",panelRef=panel,anchor=anchor,open=open,onOpenChange=setOpen,width=p.menuWidth,maxHeight=p.maxHeight or 320,scrollable=false}, {
			p.searchable and h("TextInput",{name="DropdownSearch",ref=search,value=query,placeholder="Search…",onChange=function(text) setQuery(text); setHighlighted(1) end}) or false,
			h("ScrollArea",{style={height=math.max(1,math.min(240,math.max(38,#filtered*38),math.min(p.maxHeight or 320,viewport.Y-16)-(if p.searchable then 64 else 24)))},contentStyle={gap=2}},
				if #filtered==0 then {h("Text",{text="No matches",style={color="$muted",height=36}})}
				else Element.list(filtered,function(item,index)
					return h("Button",{text=(if selected(item.value) then "✓  " else "    ")..item.label,disabled=item.disabled,variant="ghost",
						style={height=36,textAlign="left",color=if selected(item.value) then "$accent" else "$text",background="$hover",backgroundTransparency=if highlighted==index then 0 else 1},
						onClick=function() choose(item) end,accessibleName=item.label..(if selected(item.value) then ", selected" else "")})
				end,function(item) return item.key end)),
		}),
	})
end
function Dropdowns.SearchableDropdown(p)
	local copy=table.clone(p); copy.searchable=true
	return h(Dropdowns.Dropdown,copy)
end
function Dropdowns.MultiSelect(p)
	local copy=table.clone(p); copy.multiple=true; copy.searchable=if p.searchable==nil then true else p.searchable
	return h(Dropdowns.Dropdown,copy)
end
return Dropdowns

end
-- END components/inputs/Dropdown

-- BEGIN components/inputs/Selection
__modules["components/inputs/Selection"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Common=__require("components/Common")
local Style=__require("styling/StyleResolver")
local h=Element.h
local Selection={}
function Selection.RadioGroup(p)
	local options=Hooks.useMemo(function() return Common.options(p.options or {}) end,{p.options})
	local value,setValue=Common.controllable(p,options[1] and options[1].value or "")
	local ref=Hooks.useRef(nil)
	local function nextOption(direction)
		if p.disabled or #options==0 then return end
		local index=1
		for i,item in options do if item.value==value then index=i; break end end
		for _=1,#options do
			index=(index-1+direction)%#options+1
			if not options[index].disabled then setValue(options[index].value); return true end
		end
	end
	Common.key(ref,function(key)
		if key==Enum.KeyCode.Left or key==Enum.KeyCode.Up then return nextOption(-1)
		elseif key==Enum.KeyCode.Right or key==Enum.KeyCode.Down then return nextOption(1) end
	end,true)
	return h("Column",{name=p.name,ref=ref,style=p.style}, {
		p.label and h("Text",{text=p.label,style={font="$typography.medium",textSize=13}}) or false,
		h(if p.horizontal then "Row" else "Column",{style=if p.horizontal then {distribute="fill",gap=4} else {gap=4}},
			Element.list(options,function(item)
				return h("Button",{text=(if p.segmented then "" elseif value==item.value then "◉  " else "○  ")..item.label,
					disabled=p.disabled or item.disabled,variant=if p.segmented and value==item.value then "primary" else "ghost",
					style={textAlign=if p.segmented then "center" else "left",color=if value==item.value and not p.segmented then "$accent" else nil},
					onClick=function() setValue(item.value) end,role="radio",accessibleName=item.label,accessibleValue=tostring(value==item.value)})
			end,function(item) return item.key end)),
	})
end
function Selection.SegmentedControl(p)
	local copy=table.clone(p); copy.segmented=true; copy.horizontal=true
	return h(Selection.RadioGroup,copy)
end
return Selection

end
-- END components/inputs/Selection

-- BEGIN components/inputs/ColorPicker
__modules["components/inputs/ColorPicker"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Common=__require("components/Common")
local h=Element.h
local ColorPicker={}
local function hex(color)
	return string.format("#%02X%02X%02X",math.round(color.R*255),math.round(color.G*255),math.round(color.B*255))
end
function ColorPicker.ColorPicker(p)
	local env=Hooks.useEnvironment()
	local value,setValue=Common.controllable(p,env.theme:Get().accent)
	assert(typeof(value)=="Color3","ColorPicker requires a Color3 value")
	local open,setOpen=Hooks.useState(false)
	local draft,setDraft=Hooks.useState(hex(value))
	local invalid,setInvalid=Hooks.useState(false)
	local anchor=Hooks.useRef(nil)
	Hooks.useEffect(function() setDraft(hex(value)) end,{value})
	return h("Column",{name=p.name,style=p.style}, {
		p.label and h("Text",{text=p.label,style={font="$typography.medium",textSize=13}}) or false,
		h("Button",{ref=anchor,text=hex(value),disabled=p.disabled,onClick=function() setOpen(not open) end,
			accessibleName=p.accessibleName or p.label or "Choose color",style={textAlign="left",paddingX=42}}, {
			h("Frame",{style={width=22,height=22,position=UDim2.new(0,10,0.5,0),anchor=Vector2.new(0,0.5),radius=4,background=value,backgroundTransparency=0}}),
		}),
		h("Popover",{anchor=anchor,open=open and not p.disabled,onOpenChange=setOpen,width=290}, {
			h("Text",{text="Color channels",style={font="$typography.medium"}}),
			h("Slider",{label="Red",value=math.round(value.R*255),min=0,max=255,onChange=function(n) setValue(Color3.new(n/255,value.G,value.B)) end}),
			h("Slider",{label="Green",value=math.round(value.G*255),min=0,max=255,onChange=function(n) setValue(Color3.new(value.R,n/255,value.B)) end}),
			h("Slider",{label="Blue",value=math.round(value.B*255),min=0,max=255,onChange=function(n) setValue(Color3.new(value.R,value.G,n/255)) end}),
			h("TextInput",{label="Hex",value=draft,onChange=function(text) setDraft(text); setInvalid(false) end,onCommit=function(text)
				local match=string.match(text,"^#?([%x][%x][%x][%x][%x][%x])$")
				if not match then setInvalid(true); setDraft(hex(value)); return end
				setValue(Color3.fromRGB(tonumber(string.sub(match,1,2),16),tonumber(string.sub(match,3,4),16),tonumber(string.sub(match,5,6),16)))
			end}),
			invalid and h("Text",{text="Use a six-digit RGB hex color",style={color="$danger",textSize=12}}) or false,
		}),
	})
end
return ColorPicker

end
-- END components/inputs/ColorPicker

-- BEGIN components/inputs/Keybind
__modules["components/inputs/Keybind"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Input=__require("runtime/Input")
local Common=__require("components/Common")
local h=Element.h
local Keybind={}
function Keybind.Keybind(p)
	local value,setValue=Common.controllable(p,"None")
	assert(type(value)=="string","Keybind values are KeyCode names or 'None'")
	if value~="None" then assert(pcall(function() return Enum.KeyCode[value] end),"Unknown KeyCode: "..value) end
	local listening,setListening=Hooks.useState(false)
	local env=Hooks.useEnvironment()
	local ref=Hooks.useRef(nil)
	local latest=Common.latest({props=p,value=value,change=setValue,listening=listening})
	Hooks.useEffect(function()
		return env.input:Subscribe("began",function(input,processed)
			local current=latest.current
			if not input or not Input.visible(ref.current) or not env.overlays:Allows(ref.current) or current.props.disabled then return end
			if input.UserInputType~=Enum.UserInputType.Keyboard then return end
			if current.listening then
				if input.KeyCode==Enum.KeyCode.Escape then setListening(false); return true end
				if input.KeyCode==Enum.KeyCode.Unknown then return true end
				current.change(if input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.Delete then "None" else input.KeyCode.Name)
				current.listening=false; setListening(false); return true
			end
			if not processed and not env.input.uis:GetFocusedTextBox() and input.KeyCode.Name==current.value and current.props.onTrigger then current.props.onTrigger(input) end
		end)
	end,{})
	return h("Column",{name=p.name,style=p.style}, {
		p.label and h("Text",{text=p.label,style={font="$typography.medium",textSize=13}}) or false,
		h("Button",{ref=ref,text=if listening then "Press a key…  Esc cancels" else value,disabled=p.disabled,active=listening,
			style={active={borderColor="$accent",color="$accent"}},onClick=function() setListening(true) end,
			accessibleName=(p.label or "Keybind")..", "..value}),
	})
end
return Keybind

end
-- END components/inputs/Keybind

-- BEGIN components/feedback/Feedback
__modules["components/feedback/Feedback"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Style=__require("styling/StyleResolver")
local Scope=__require("utils/Scope")
local Common=__require("components/Common")
local h=Element.h
local Feedback={}
local statuses={success="$success",warning="$warning",error="$danger",info="$accent",idle="$subtle"}
function Feedback.StatusIndicator(p)
	local color=statuses[p.status or "info"]
	assert(color,"Unknown status")
	return h("Row",{name=p.name,style=Style.merge({width="auto",height=24,gap=6},p.style)}, {
		h("Frame",{style={width=7,height=7,radius="$radius.pill",background=color,backgroundTransparency=0}}),
		p.text and h("Text",{text=p.text,style={width="auto",height=24,color="$muted",textSize=12}}) or false,
	})
end
function Feedback.ProgressBar(p)
	local value=p.value or 0
	assert(Common.finite(value),"Progress value must be finite")
	value=math.clamp(value,0,1)
	return h("Column",{name=p.name,style=p.style}, {
		p.label and h("Text",{text=p.label.."  "..math.round(value*100).."%",style={textSize=12,color="$muted"}}) or false,
		h("Frame",{role="progressbar",accessibleName=p.label,accessibleValue=tostring(value),style={height=p.height or 6,background="$input",backgroundTransparency=0,radius="$radius.pill",overflow="hidden"}}, {
			h("Frame",{motion=true,style={width=UDim.new(value,0),height="100%",background=p.color or "$accent",backgroundTransparency=0,radius="$radius.pill"}}),
		}),
	})
end
function Feedback.LoadingIndicator(p)
	local env=Hooks.useEnvironment()
	local ref=Hooks.useRef(nil)
	Hooks.useEffect(function()
		return env.animator:To(ref.current,{Rotation=360},0.9,{repeatCount=-1,easing=Enum.EasingStyle.Linear})
	end,{})
	return h("Row",{name=p.name,style=Style.merge({width="auto",height=28},p.style)}, {
		h("Text",{ref=ref,text="◌",style={width=22,height=22,textSize=22,textAlign="center",color="$accent"}}),
		h("Text",{text=p.text or "Loading…",style={width="auto",height=28,color="$muted"}}),
	})
end
function Feedback.Tooltip(p)
	local open,setOpen=Hooks.useState(false)
	local ref=Hooks.useRef(nil)
	local scope=Common.scope()
	local pending=Hooks.useRef(nil)
	local env=Hooks.useEnvironment()
	local function hide()
		if pending.current then pending.current(); pending.current=nil end
		setOpen(false)
	end
	local function show()
		if p.disabled then return end
		if pending.current then pending.current() end
		pending.current=scope:Delay(p.delay or 0.45,function() pending.current=nil; setOpen(true) end)
	end
	Hooks.useEffect(function()
		local connectionScope=Scope.new()
		connectionScope:Connect(env.input.guiService:GetPropertyChangedSignal("SelectedObject"),function()
			local selected=env.input.guiService.SelectedObject
			if selected and ref.current and selected:IsDescendantOf(ref.current) then show() else hide() end
		end)
		return function() connectionScope:Destroy() end
	end,{})
	return h(Element.Fragment,{}, {
		h("Frame",{ref=ref,name=p.name,style=p.style,events={MouseEnter=show,MouseLeave=hide}},p.children),
		h("Popover",{anchor=ref,open=open,onOpenChange=setOpen,width=p.width or 240,maxHeight=180}, {
			h("Text",{text=p.text,style={textSize=12,color="$text",wrapped=true}}),
		}),
	})
end
function Feedback.Toast(p)
	local open,setOpen=Common.controllable(p,true,"open","onOpenChange","defaultOpen")
	local present=Common.presence(open)
	local env=Hooks.useEnvironment()
	local ref=Hooks.useRef(nil)
	Hooks.useEffect(function()
		if not present or not ref.current then return end
		if open then ref.current.GroupTransparency=1 end
		return env.animator:To(ref.current,{GroupTransparency=if open then 0 else 1},env.theme:Get().motion.normal)
	end,{open,present})
	Hooks.useEffect(function()
		if p.duration and open then
			local scope=Scope.new(); scope:Delay(p.duration,function() setOpen(false) end)
			return function() scope:Destroy() end
		end
	end,{open,p.duration})
	if not present then return nil end
	return h("@CanvasGroup",{ref=ref,name=p.name or "Toast",role="status",accessibleName=(p.title or "Notification")..": "..(p.message or ""),
		style=Style.merge({width="100%",height="auto",background="$surface",backgroundTransparency=0,borderWidth=1,borderColor="$border",
			radius="$radius.lg",padding=14,direction="column",gap=8},p.style)}, {
		h("Row",{}, {
			h(Feedback.StatusIndicator,{status=p.status or "info"}),
			h("Text",{text=p.title or "Notification",style={width=UDim.new(1,-59),height=24,font="$typography.medium"}}),
			h("Button",{text="×",variant="ghost",accessibleName="Dismiss notification",style={width=26,height=26,paddingX=0},onClick=function() setOpen(false) end}),
		}),
		p.message and h("Paragraph",{text=p.message,style={textSize=13}}) or false,
	})
end
Feedback.Notification=Feedback.Toast
function Feedback.ToastHost()
	local env=Hooks.useEnvironment()
	local items=Hooks.useSignal(env.notifications.signal)
	return h("Column",{name="Notifications",style={width=UDim.new(1,-32),maxWidth=350,height="auto",position=UDim2.new(1,-16,0,16),anchor=Vector2.new(1,0),gap=10}},
		Element.list(items,function(item)
			return h(Feedback.Toast,{title=item.options.title,message=item.options.message,status=item.options.status,open=not item.closing,
				onOpenChange=function(open) if not open then env.notifications:Dismiss(item.id) end end})
		end,function(item) return item.id end))
end
return Feedback

end
-- END components/feedback/Feedback

-- BEGIN menu/Facade
__modules["menu/Facade"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Signal=__require("core/Signal")
local Scope=__require("utils/Scope")
local Common=__require("components/Common")
local h=Element.h
local Facade={}
local Handle={}
Handle.__index=Handle
local Control={}
Control.__index=Control
local windowSerial,serial=0,0
local valueKinds={Toggle=true,Switch=true,Checkbox=true,Slider=true,RangeSlider=true,Dropdown=true,SearchableDropdown=true,MultiSelect=true,
	TextInput=true,NumericInput=true,ColorPicker=true,Keybind=true,RadioGroup=true,SegmentedControl=true,ProgressBar=true}
local function defaults(kind,options,library)
	if options.Value~=nil then return options.Value end
	if options.Default~=nil then return options.Default end
	if kind=="Toggle" or kind=="Switch" or kind=="Checkbox" then return false end
	if kind=="Slider" then return options.Min or 0 end
	if kind=="NumericInput" then return options.Min or 0 end
	if kind=="ProgressBar" then return 0 end
	if kind=="RangeSlider" then return {options.Min or 0,options.Max or 100} end
	if kind=="MultiSelect" then return {} end
	if kind=="ColorPicker" then return library.Theme:Get().accent end
	if kind=="Keybind" then return "None" end
	if kind=="RadioGroup" or kind=="SegmentedControl" then local optionsList=Common.options(options.Options or {}); return optionsList[1] and optionsList[1].value or "" end
	return ""
end
local function validate(kind,value,options)
	if kind=="Toggle" or kind=="Switch" or kind=="Checkbox" then return type(value)=="boolean","Expected boolean" end
	if kind=="Slider" then return Common.finite(value) and value&gt;=(options.Min or 0) and value&lt;=(options.Max or 100),"Number is outside the slider range" end
	if kind=="ProgressBar" then return Common.finite(value) and value&gt;=0 and value&lt;=1,"Progress must be 0..1" end
	if kind=="NumericInput" then
		return Common.finite(value) and value&gt;=(options.Min or -math.huge) and value&lt;=(options.Max or math.huge),"Number is outside the configured range"
	end
	if kind=="RangeSlider" then
		return type(value)=="table" and #value==2 and Common.finite(value[1]) and Common.finite(value[2]) and value[1]&lt;=value[2]
			and value[1]&gt;=(options.Min or 0) and value[2]&lt;=(options.Max or 100),"Expected ordered {low, high} in range"
	end
	if kind=="ColorPicker" then return typeof(value)=="Color3","Expected Color3" end
	if kind=="MultiSelect" then
		if type(value)~="table" then return false,"Expected an array of options" end
		local seen={}
		for _,entry in value do
			if seen[entry] or not Common.label(Common.options(options.Options or {}),entry) then return false,"Unknown or duplicate selected option" end
			seen[entry]=true
		end
		return true
	end
	if kind=="Dropdown" or kind=="SearchableDropdown" or kind=="RadioGroup" or kind=="SegmentedControl" then
		return value=="" or Common.label(Common.options(options.Options or {}),value)~=nil,"Unknown selected option"
	end
	if kind=="Keybind" then
		if value=="None" then return true end
		local ok,item=pcall(function() return Enum.KeyCode[value] end)
		return ok and item~=nil,"Unknown KeyCode"
	end
	return type(value)=="string","Expected string"
end
local function propsFor(record)
	local o=record.options
	local p={name=record.name,label=o.Title,text=o.Text or o.Title,description=o.Description,style=o.Style,disabled=o.Disabled,accessibleName=o.AccessibleName,
		min=o.Min,max=o.Max,step=o.Step,options=o.Options,placeholder=o.Placeholder,searchable=o.Searchable,multiple=o.Multiple,
		multiline=o.Multiline,maxLength=o.MaxLength,variant=o.Variant,format=o.Format,onCommit=o.OnCommit,onTrigger=o.Triggered,
		glyph=o.Glyph,image=o.Image,size=o.Size,status=o.Status,message=o.Message,content=o.Content}
	if record.kind=="Button" then p.onClick=o.Callback end
	if record.kind=="Paragraph" then p.text=o.Content or o.Text or o.Title end
	return p
end
local function ControlView(p)
	local record=p.record
	Hooks.useSignal(record.revision)
	local props=propsFor(record)
	if record.signal then
		props.value=Hooks.useSignal(record.signal)
		props.onChange=function(value) record:SetValue(value) end
	end
	return h(record.kind,props)
end
local function ContainerView(p)
	local record=p.record
	Hooks.useSignal(record.revision)
	local children=Element.list(record.children,function(child)
		return h(if child.container then ContainerView else ControlView,{record=child})
	end,function(child) return child.id end)
	return h(if record.kind=="Section" then "Section" elseif record.kind=="Collapsible" then "Collapsible" else "Column",
		{title=record.options.Title,description=record.options.Description,defaultOpen=record.options.DefaultOpen,style=record.options.Style},children)
end
local function WindowView(p)
	local window=p.window
	Hooks.useSignal(window.revision)
	local items={}
	for _,tab in window.children do
		table.insert(items,{id=tab.id,title=tab.options.Title or "Tab",content=h(ContainerView,{record=tab})})
	end
	local o=window.options
	return h("Window",{id=window.id,name=window.name,title=o.Title or "Application",size=o.Size or {720,500},position=o.Position,
		minSize=o.MinSize,maxSize=o.MaxSize,fixedSize=o.FixedSize,openKey=o.OpenKey,theme=o.Theme,windowRef=window.windowRef,
		onClose=function()
			window.scope:Delay(if window.library._env.animator.reducedMotion then 0 else window.library.Theme:Get().motion.normal,function() window:Destroy() end)
			if o.OnClose then o.OnClose() end
		end}, {
		h("Tabs",{items=items,orientation=if o.Navigation=="Top" then "top" else "sidebar",defaultValue=items[1] and items[1].id}),
	})
end
local function bump(record) if record.alive then record.revision:update(function(n) return n+1 end) end end
local function newContainer(parent,kind,options)
	assert(parent.alive,"Container is destroyed")
	serial+=1
	local record=setmetatable({id=kind..":"..serial,kind=kind,container=true,alive=true,options=table.clone(options or {}),children={},parent=parent,
		library=parent.library,window=parent.window or parent,scope=Scope.new(),revision=Signal.new(0)},Handle)
	table.insert(parent.children,record); bump(parent)
	return record
end
function Handle:AddTab(options)
	assert(self.kind=="Window","AddTab belongs to a window")
	return newContainer(self,"Tab",options)
end
function Handle:AddSection(options) return newContainer(self,"Section",options) end
function Handle:AddCollapsible(options) return newContainer(self,"Collapsible",options) end
function Handle:Update(patch)
	assert(self.alive,"Handle is destroyed")
	for key,value in patch do self.options[key]=value end
	bump(self)
end
function Control:SetValue(value)
	assert(self.alive and self.signal,"Control has no mutable value")
	local ok,reason=validate(self.kind,value,self.options); assert(ok,reason)
	self.signal:set(value)
end
function Control:GetValue() assert(self.signal,"Control has no value"); return self.signal:get() end
function Control:OnChanged(callback)
	assert(self.alive and self.signal,"Control has no value")
	local disconnect=self.signal:subscribe(callback)
	self.scope:Add(disconnect)
	return function() self.scope:Remove(disconnect,true) end
end
function Control:Update(patch)
	assert(self.alive,"Control is destroyed")
	assert(patch.Id==nil and patch.Default==nil and patch.Value==nil,"Use SetValue for values; Id and Default are immutable")
	local nextOptions=table.clone(self.options)
	for key,value in patch do nextOptions[key]=value end
	if self.signal then local ok,reason=validate(self.kind,self.signal:get(),nextOptions); assert(ok,reason) end
	self.options=nextOptions; bump(self)
end
function Control:GetInstance() return self.window.root and self.window.root:Find(self.name) end
local function destroy(record)
	if not record.alive then return end
	record.alive=false
	if record.disposeLibrary then record.library._scope:Remove(record.disposeLibrary,false); record.disposeLibrary=nil end
	if record.root then record.root:Unmount() end
	if record.children then for _,child in table.clone(record.children) do destroy(child) end; table.clear(record.children) end
	record.scope:Destroy()
	if record.signal then record.signal:Destroy() end
	record.revision:Destroy()
	if record.parent and record.parent.alive then
		local index=table.find(record.parent.children,record)
		if index then table.remove(record.parent.children,index); bump(record.parent) end
	end
end
function Handle:Destroy() destroy(self) end
Control.Destroy=Handle.Destroy
for _,method in {"Show","Hide","Minimize","Restore","Focus"} do
	Handle[method]=function(self)
		assert(self.kind=="Window" and self.alive,"Window handle is destroyed")
		local entry=self.windowRef.current
		if entry then entry[method](entry) end
	end
end
function Handle:SetSize(width,height)
	assert(self.kind=="Window" and self.alive,"Window handle is destroyed")
	if self.windowRef.current then self.windowRef.current:SetSize(width,height) end
end
function Handle:SetTheme(theme) self:Update({Theme=theme}) end
function Handle:GetInstance() return self.root and self.root:Find(self.name) end
function Handle:GetRect() return self.windowRef.current and self.windowRef.current:GetRect() end
local function addControl(parent,kind,options)
	assert(parent.alive and parent.kind~="Window","Add controls to a tab or section")
	options=options or {}; serial+=1
	local record=setmetatable({id="control:"..serial,kind=kind,alive=true,options=table.clone(options),parent=parent,window=parent.window,
		library=parent.library,scope=Scope.new(),revision=Signal.new(0),name=options.Name or kind..":"..serial},Control)
	if valueKinds[kind] then
		local value=defaults(kind,options,parent.library)
		local ok,reason=validate(kind,value,options); assert(ok,reason)
		record.signal=Signal.new(value)
		if options.Id then
			record.ConfigId=parent.window.id.."/"..options.Id
			record.scope:Add(parent.library.Config:Register(record.ConfigId,record.signal,value,function(nextValue) return validate(kind,nextValue,record.options) end))
		end
		record.scope:Add(record.signal:subscribe(function(nextValue)
			if record.options.Callback then record.options.Callback(nextValue) end
		end))
	end
	table.insert(parent.children,record); bump(parent)
	return record
end
for _,kind in {"Button","Toggle","Switch","Checkbox","Slider","RangeSlider","Dropdown","SearchableDropdown","MultiSelect","TextInput","NumericInput",
	"ColorPicker","Keybind","RadioGroup","SegmentedControl","Text","Label","RichText","Paragraph","Icon","Badge","Separator","ProgressBar","LoadingIndicator","StatusIndicator"} do
	Handle["Add"..kind]=function(self,options) return addControl(self,kind,options) end
end
function Facade.create(library,options)
	library:_ensure()
	options=options or {}; windowSerial+=1
	local id=options.Id or "menu-"..windowSerial
	assert(type(id)=="string","Window Id must be a string")
	local window=setmetatable({id=id,name="MenuWindow:"..id,kind="Window",alive=true,library=library,options=table.clone(options),children={},
		revision=Signal.new(0),scope=Scope.new(),windowRef={},Config=library.Config},Handle)
	window.window=window
	window.root=library:Mount(h(WindowView,{window=window}))
	window.disposeLibrary=library._scope:Add(function() window:Destroy() end)
	return window
end
return Facade

end
-- END menu/Facade

-- BEGIN init
__modules["init"] = function(__require)
--!nonstrict
local Element=__require("core/Element")
local Hooks=__require("core/Hooks")
local Signal=__require("core/Signal")
local Renderer=__require("core/Renderer")
local Theme=__require("styling/Theme")
local Style=__require("styling/StyleResolver")
local Adapter=__require("runtime/Adapter")
local Input=__require("runtime/Input")
local Overlays=__require("runtime/Overlays")
local Manager=__require("window/Manager")
local Animator=__require("animation/Animator")
local Config=__require("config/Config")
local Notifications=__require("feedback/Notifications")
local Scope=__require("utils/Scope")
local Diagnostics=__require("utils/Diagnostics")
local Primitives=__require("components/primitives/Primitives")
local Sections=__require("components/layout/Sections")
local OverlayComponents=__require("components/layout/Overlays")
local Windows=__require("components/layout/Window")
local Tabs=__require("components/navigation/Tabs")
local Boolean=__require("components/inputs/Boolean")
local TextInputs=__require("components/inputs/TextInput")
local Sliders=__require("components/inputs/Slider")
local Dropdowns=__require("components/inputs/Dropdown")
local Selection=__require("components/inputs/Selection")
local ColorPicker=__require("components/inputs/ColorPicker")
local Keybind=__require("components/inputs/Keybind")
local Feedback=__require("components/feedback/Feedback")
local Facade=__require("menu/Facade")
Primitives.register()
for _,group in {Sections,OverlayComponents,Windows,Tabs,Boolean,TextInputs,Dropdowns,Selection,ColorPicker,Keybind,Feedback} do
	for name,component in group do Element.register(name,component) end
end
Element.register("Slider",Sliders.Slider); Element.register("RangeSlider",Sliders.RangeSlider)
Element.register("CollapsibleSection",Sections.Collapsible)
local Library={}
Library.__index=Library
function Library.new(options)
	options=options or {}
	local self=setmetatable({Version="1.0.0",options=options,_roots={},_scope=Scope.new(),_destroyed=false},Library)
	self.Theme=Theme.new(options.theme or "Dark")
	self.Config=Config.new(game:GetService("HttpService"),Adapter.capabilities(options.capabilities),options.config)
	self.UI={h=Element.h,Fragment=Element.Fragment,portal=Element.portal,list=Element.list,signal=Signal.new,derived=Signal.derived,batch=Signal.batch,
		useState=Hooks.useState,useRef=Hooks.useRef,useMemo=Hooks.useMemo,useEffect=Hooks.useEffect,useSignal=Hooks.useSignal,useTheme=Hooks.useTheme,
		useEnvironment=Hooks.useEnvironment,mergeStyles=Style.merge,
		when=function(condition,yes,no) return if condition then yes else no end,
		mount=function(element,parent,opts) return self:Mount(element,parent,opts) end,
		flush=function(root) if root then return root:Flush() end; self:Flush() end}
	self.new=Library.new
	return self
end
function Library:_ensure()
	assert(not self._destroyed,"Library is destroyed; create another with Library.new()")
	if self._env then return self._env end
	local runtime=Adapter.new(self.options,function() self:Destroy() end)
	local input=Input.new(runtime.services.UserInputService,runtime.services.GuiService)
	local animator=Animator.new(runtime.services.TweenService,self.options.reducedMotion)
	local overlays=Overlays.new(input)
	local windows=Manager.new(runtime,input,overlays)
	local notifications=Notifications.new(self.Theme,animator)
	self._env={runtime=runtime,input=input,animator=animator,overlays=overlays,windows=windows,notifications=notifications,theme=self.Theme,library=self}
	self:Mount(Windows and Element.h(Windows.RecoveryHost),runtime.layers.main)
	self:Mount(Element.h(Feedback.ToastHost),runtime.layers.toast)
	return self._env
end
function Library:Mount(element,parent,options)
	local env=self:_ensure()
	options=options or {}
	local root=Renderer.mount(element,parent or env.runtime.layers.main,env,{onError=options.onError or self.options.onError,
		onUnmount=function(unmounted) self._roots[unmounted]=nil end})
	if self._destroyed then root:Unmount(); error("Library was destroyed during mounting",2) end
	if root.alive then self._roots[root]=true end
	return root
end
function Library:Flush()
	for root in table.clone(self._roots) do if root.alive then root:Flush() end end
end
function Library:CreateWindow(options) return Facade.create(self,options) end
function Library:SetTheme(theme) assert(not self._destroyed,"Library is destroyed"); self.Theme:Set(theme) end
function Library:SetReducedMotion(value) self:_ensure().animator:SetReducedMotion(value) end
function Library:Notify(options) return self:_ensure().notifications:Push(options) end
function Library:Confirm(options)
	self:_ensure(); options=table.clone(options or {})
	local original=options.onResult
	local root,finished
	local function finish(result)
		if finished then return end
		finished=true
		options.open=false
		if root and root.alive then root:Update(Element.h("ConfirmationDialog",options)) end
		self._scope:Delay(if self._env.animator.reducedMotion then 0 else self.Theme:Get().motion.normal,function() if root then root:Unmount() end end)
		if original then original(result) end
	end
	options.onResult=finish; options.open=true
	root=self:Mount(Element.h("ConfirmationDialog",options))
	return {Close=function() finish(false) end,Destroy=function() finished=true; root:Unmount() end,root=root}
end
function Library:GetDiagnostics() return Diagnostics.snapshot() end
function Library:GetRuntimeInfo()
	local capabilities={}
	for name in Adapter.capabilities(self.options.capabilities) do capabilities[name]=true end
	return {capabilities=capabilities,parentMode=self._env and self._env.runtime.parentMode or "uninitialized",version=self.Version}
end
function Library:Destroy()
	if self._destroyed then return end
	self._destroyed=true
	for root in table.clone(self._roots) do root:Unmount() end
	self._scope:Destroy()
	if self._env then
		self._env.notifications:Destroy(); self._env.windows:Destroy(); self._env.overlays:Destroy()
		self._env.input:Destroy(); self._env.animator:Destroy(); self._env.runtime:Destroy()
	end
	self.Config:Destroy(); self.Theme:Destroy()
end
return Library.new()

end
-- END init

return __require("init")
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">AsterSmoke</string><ProtectedString name="Source">-- Real Roblox client tests. Run from Bootstrap.client.luau in Studio Play mode.
return function(Library)
	local HttpService=game:GetService("HttpService")
	local RunService=game:GetService("RunService")
	local reports={}
	local serial=0
	local function equal(a,b) assert(a==b,tostring(a).." ~= "..tostring(b)) end
	local function test(name,callback)
		serial+=1
		local lib=Library.new({id="studio-smoke-"..serial,reducedMotion=true,capabilities={}})
		local ok,err=xpcall(function() callback(lib,lib.UI) end,debug.traceback)
		lib:Destroy(); RunService.Heartbeat:Wait()
		local counts=Library:GetDiagnostics()
		for key,value in counts do if key~="renders" and value~=0 then ok=false; err=tostring(err).."; leaked "..key.."="..value end end
		table.insert(reports,{name=name,passed=ok,error=if ok then nil else tostring(err)})
		print("MATTLIB_STUDIO_"..(if ok then "PASS " else "FAIL ")..name..(if ok then "" else ": "..tostring(err)))
	end
	test("functional updates preserve native instances",function(lib,UI)
		local set
		local function App() local count,update=UI.useState(0); set=update; return UI.h("Button",{name="count",text=tostring(count)}) end
		local root=UI.mount(UI.h(App)); local instance=root:Find("count")
		set(function(n) return n+1 end); set(function(n) return n+1 end); root:Flush()
		equal(root:Find("count"),instance); equal(instance.Text,"2")
	end)
	test("keyed reorder and removal",function(lib,UI)
		local function list(ids) return UI.h("Column",{},UI.list(ids,function(id) return UI.h("Text",{name=id,text=id}) end,function(id) return id end)) end
		local root=UI.mount(list({"a","b","c"})); local a,c=root:Find("a"),root:Find("c")
		root:Update(list({"c","a"})):Flush(); equal(root:Find("a"),a); equal(root:Find("c"),c); equal(a.LayoutOrder,2); equal(root:Find("b"),nil)
	end)
	test("effects and event cleanup",function(lib,UI)
		local cleanup=0
		local function App() UI.useEffect(function() return function() cleanup+=1 end end,{}); return UI.h("Button",{text="Events"}) end
		lib:_ensure(); RunService.Heartbeat:Wait(); local baseline=lib:GetDiagnostics()
		local root=UI.mount(UI.h(App)); root:Unmount(); equal(cleanup,1)
		equal(lib:GetDiagnostics().connections,baseline.connections); equal(lib:GetDiagnostics().instances,baseline.instances)
	end)
	test("native theme and state styles",function(lib,UI)
		local root=UI.mount(UI.h("Button",{name="theme",text="Themed",variant="primary"})); local instance=root:Find("theme")
		lib:SetTheme("Light"); equal(instance.BackgroundColor3,lib.Theme:Get().accent)
		lib.Theme:Extend({accent=Color3.fromRGB(30,110,220)}); equal(instance.BackgroundColor3,Color3.fromRGB(30,110,220))
	end)
	test("controlled text restores an unaccepted native edit",function(lib,UI)
		local changed=""
		local root=UI.mount(UI.h("TextInput",{name="text",value="fixed",onChange=function(value) changed=value end})); local box=root:Find("text")
		box.Text="edit"; RunService.Heartbeat:Wait(); lib:Flush()
		equal(changed,"edit"); equal(box.Text,"fixed")
	end)
	test("control library creates valid native properties",function(lib,UI)
		local root=UI.mount(UI.h("Column",{}, {
			UI.h("Toggle",{label="Toggle"}),UI.h("Checkbox",{label="Checkbox"}),UI.h("Slider",{}),UI.h("RangeSlider",{}),UI.h("TextInput",{}),UI.h("NumericInput",{}),
			UI.h("Dropdown",{options={"A","B"}}),UI.h("SearchableDropdown",{options={"A","B"}}),UI.h("MultiSelect",{options={"A","B"}}),
			UI.h("ColorPicker",{}),UI.h("Keybind",{}),UI.h("RadioGroup",{options={"A","B"}}),UI.h("SegmentedControl",{options={"A","B"}}),
			UI.h("LoadingIndicator",{}),UI.h("ProgressBar",{value=0.5}),UI.h("StatusIndicator",{text="Ready"}),UI.h("Icon",{glyph="◇"}),
			UI.h("Collapsible",{title="Open",defaultOpen=true},UI.h("Text",{text="Inside"})),
		}))
		RunService.Heartbeat:Wait(); root:Flush(); assert(root.alive)
	end)
	test("window geometry, visibility and lifecycle",function(lib,UI)
		local ref={}
		local root=UI.mount(UI.h("Window",{id="window",title="Native window",windowRef=ref,size={500,360}}))
		RunService.Heartbeat:Wait(); lib:Flush(); assert(ref.current)
		ref.current:Minimize(); root:Flush(); equal(ref.current:GetRect().height,44)
		ref.current:Restore(); root:Flush(); ref.current:Hide(); root:Flush(); equal(root:Find("Window:window").Visible,false)
		ref.current:Show(); root:Flush(); ref.current:SetSize(10000,10000)
		local rect=ref.current:GetRect(); local viewport=lib._env.runtime.layers.main.AbsoluteSize
		assert(rect.width&lt;=viewport.X and rect.height&lt;=viewport.Y)
		root:Unmount(); equal(ref.current,nil); equal(lib:GetDiagnostics().windows,0)
	end)
	test("native flex and modifiers",function(lib,UI)
		local root=UI.mount(UI.h("Row",{name="flex",style={height=80,distribute="fill",padding=12,radius=8,borderWidth=1,minWidth=100}}, {
			UI.h("Button",{text="A",style={grow=1}}),UI.h("Button",{text="B",style={grow=2}}),
		}))
		local frame=root:Find("flex"); equal(frame:FindFirstChildOfClass("UIListLayout").HorizontalFlex,Enum.UIFlexAlignment.Fill)
		assert(frame:FindFirstChildOfClass("UIPadding") and frame:FindFirstChildOfClass("UISizeConstraint"))
	end)
	test("HttpService config round trip and atomic validation",function(lib,UI)
		local bool,color=UI.signal(false),UI.signal(Color3.fromRGB(1,22,233))
		lib.Config:Register("bool",bool,false); lib.Config:Register("color",color,color:get())
		local json=assert(lib.Config:Export()); bool:set(true); color:set(Color3.new()); assert(lib.Config:Import(json))
		equal(bool:get(),false); equal(color:get(),Color3.fromRGB(1,22,233))
		equal(lib.Config:Import(HttpService:JSONEncode({schema="mattlib/config",version=1,values={bool=42}})),false)
		bool:Destroy(); color:Destroy()
	end)
	test("same-id initialization disposes the previous client",function(lib,UI)
		lib:Mount(UI.h("Button",{text="Previous"}))
		local replacement=Library.new({id=lib.options.id,reducedMotion=true,capabilities={}})
		replacement:Mount(replacement.UI.h("Text",{text="Replacement"})); equal(lib._destroyed,true); replacement:Destroy()
	end)
	test("portals and modal lifecycle",function(lib,UI)
		local root=UI.mount(UI.h("Modal",{title="Native modal"},UI.h("Button",{name="modal-action",text="Continue"})))
		RunService.Heartbeat:Wait(); assert(root:Find("modal-action"):IsDescendantOf(lib._env.runtime.layers.overlay))
		root:Update(nil):Flush(); equal(#lib._env.overlays.stack,0)
	end)
	test("menu facade renders shared inputs",function(lib)
		local window=lib:CreateWindow({Id="native-menu",Title="Facade"}); local tab=window:AddTab({Title="Main"}); local section=tab:AddSection({Title="Settings"})
		local toggle=section:AddToggle({Id="enabled",Title="Enabled",Default=false}); lib:Flush(); local native=toggle:GetInstance(); assert(native)
		toggle:SetValue(true); lib:Flush(); equal(toggle:GetInstance(),native); equal(native:GetAttribute("AsterValue"),"true")
		window:Destroy()
	end)
	test("native 360x640 constrained viewport layout",function(lib,UI)
		local env=lib:_ensure()
		for _,layer in env.runtime.layers do layer.Size=UDim2.fromOffset(360,640) end
		RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait()
		local ref={}
		local root=UI.mount(UI.h("Window",{id="mobile",title="Mobile layout",windowRef=ref,size={900,700}},UI.h("Sidebar",{items={
			{id="a",title="First",content=UI.h("Section",{title="Responsive"},UI.h("Button",{text="Action"}))},{id="b",title="Second",content=UI.h("Text",{text="Second panel"})},
		}})))
		RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait(); lib:Flush()
		local rect=ref.current:GetRect()
		assert(rect.width&lt;=344 and rect.height&lt;=624 and rect.x&gt;=8 and rect.y&gt;=8)
		equal(root:Find("TabNavigation").AbsoluteSize.Y,44)
		local modal=UI.mount(UI.h("Modal",{title="Constrained dialog"},UI.h("Paragraph",{text=string.rep("Scrollable dialog body. ",80)})))
		RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait(); lib:Flush()
		local group=modal:Find("Modal"); equal(group.AbsoluteSize.X,360); equal(group.AbsoluteSize.Y,640)
		modal:Unmount(); root:Unmount()
	end)
	local passed=0; for _,report in reports do if report.passed then passed+=1 end end
	local result={passed=passed,failed=#reports-passed,tests=reports,viewport={x=workspace.CurrentCamera.ViewportSize.X,y=workspace.CurrentCamera.ViewportSize.Y}}
	print("MATTLIB_STUDIO_RESULTS "..HttpService:JSONEncode(result))
	return result
end
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX5"><Properties><string name="Name">AsterExamples</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Gallery</string><ProtectedString name="Source">return function(Library)
	local app=Library.new({id="mattlib-gallery",theme="Dark"})
	local UI=app.UI
	local h=UI.h
	local settings={enabled=UI.signal(true),checked=UI.signal(false),volume=UI.signal(64),range=UI.signal({20,80}),
		name=UI.signal("Workspace"),number=UI.signal(8),region=UI.signal("Singapore"),tags=UI.signal({"Design","Luau"}),
		color=UI.signal(app.Theme:Get().accent),key=UI.signal("F6"),radio=UI.signal("Balanced"),segment=UI.signal("Daily")}
	for id,signal in settings do app.Config:Register("gallery/"..id,signal,signal:get()) end
	local function bind(name)
		return UI.useSignal(settings[name]),function(value) settings[name]:set(value) end
	end
	local function Metric(p)
		return h("Section",{style={width=UDim.new(1/3,-8),padding=16,gap=4}}, {
			h("Text",{text=p.label,style={color="$muted",textSize=12}}),
			h("Text",{text=p.value,style={textSize=26,font="$typography.bold"}}),
			h("StatusIndicator",{text=p.note,status="success"}),
		})
	end
	local function Overview()
		local clicks,setClicks=UI.useState(0)
		return h("Column",{style={gap=18}}, {
			h("Badge",{text="ASTER  /  COMPONENT STUDIO"}),
			h("Text",{text="A considered interface.",style={textSize=28,font="$typography.bold"}}),
			h("Paragraph",{text="A native Luau component system for interfaces that feel intentional. Explore the controls, change the theme, and build something of your own."}),
			h("Row",{style={gap=12}}, {
				h(Metric,{label="RENDERING",value="Incremental",note="Keyed reconciliation"}),
				h(Metric,{label="RUNTIME",value="Native",note="No external dependencies"}),
				h(Metric,{label="AUTHORING",value="Composable",note="One shared component system"}),
			}),
			h("Section",{title="Small interactions, shared foundations",description="State updates preserve the underlying native instances."}, {
				h("Row",{style={distribute="fill"}}, {
					h("Button",{name="GalleryCounter",text="Count  ·  "..clicks,variant="primary",onClick=function() setClicks(function(n) return n+1 end) end}),
					h("Tooltip",{text="Tooltips respond to pointer hover and native selection."},h("Button",{text="A little context",variant="secondary"})),
				}),
				h("RichText",{text="Compose &lt;b&gt;functional components&lt;/b&gt;, share &lt;i&gt;signals&lt;/i&gt;, and let the renderer own the lifecycle.",style={color="$muted"}}),
			}),
			h("ContextMenu",{items={{id="notify",label="Show notification",onSelect=function() app:Notify({title="Context action",message="The menu uses the shared popover and button components."}) end},
				{id="light",label="Switch to light",onSelect=function() app:SetTheme("Light") end}}},
				h("Section",{title="A secondary action",description="Right-click here, or long-press on a touch device, to open a context menu."},h("StatusIndicator",{status="info",text="Pointer and touch"}))),
		})
	end
	local function Inputs()
		local enabled,setEnabled=bind("enabled"); local checked,setChecked=bind("checked"); local volume,setVolume=bind("volume"); local range,setRange=bind("range")
		local name,setName=bind("name"); local number,setNumber=bind("number"); local region,setRegion=bind("region"); local tags,setTags=bind("tags")
		local color,setColor=bind("color"); local key,setKey=bind("key"); local radio,setRadio=bind("radio"); local segment,setSegment=bind("segment")
		return h("Column",{style={gap=16}}, {
			h("Text",{text="Inputs &amp; controls",style={textSize=24,font="$typography.bold"}}),
			h("Section",{title="Boolean controls"}, {
				h("Toggle",{name="GalleryToggle",label="Enable notifications",description="A controlled switch backed by a shared signal.",value=enabled,onChange=setEnabled}),
				h("Checkbox",{label="Include experimental features",value=checked,onChange=setChecked}),
				h("Toggle",{label="Unavailable setting",disabled=true,value=false}),
			}),
			h("Section",{title="Continuous values"}, {
				h("Slider",{label="Output level",min=0,max=100,value=volume,onChange=setVolume,format=function(n) return n.."%" end}),
				h("RangeSlider",{label="Operating range",min=0,max=100,value=range,onChange=setRange}),
			}),
			h("Section",{title="Text &amp; selection"}, {
				h("TextInput",{label="Workspace name",value=name,onChange=setName,maxLength=48}),
				h("NumericInput",{label="Concurrency",min=1,max=32,step=1,value=number,onChange=setNumber}),
				h("Dropdown",{label="Region",options={"Singapore","Tokyo","Frankfurt","Virginia"},value=region,onChange=setRegion}),
				h("SearchableDropdown",{label="Search regions",options={"Singapore","Tokyo","Frankfurt","Virginia","Sydney","London","Mumbai"},value=region,onChange=setRegion}),
				h("MultiSelect",{label="Project tags",options={"Design","Luau","Research","Testing","Release"},value=tags,onChange=setTags}),
			}),
			h("Section",{title="Specialized controls"}, {
				h("ColorPicker",{label="Highlight color",value=color,onChange=setColor}),
				h("Keybind",{label="Quick action",value=key,onChange=setKey,onTrigger=function() app:Notify({title="Keybind",message="Your configured keyboard shortcut fired."}) end}),
				h("RadioGroup",{label="Performance profile",options={"Economy","Balanced","Performance"},value=radio,onChange=setRadio}),
				h("SegmentedControl",{label="Time period",options={"Daily","Weekly","Monthly"},value=segment,onChange=setSegment}),
			}),
		})
	end
	local function Layouts()
		return h("Column",{style={gap=16}}, {
			h("Text",{text="Layout &amp; hierarchy",style={textSize=24,font="$typography.bold"}}),
			h("Section",{title="Rows and columns",description="Native list layouts with shared gap and padding utilities."}, {
				h("Row",{style={distribute="fill"}}, {h("Button",{text="One"}),h("Button",{text="Two"}),h("Button",{text="Three"})}),
				h("Separator"),h("Paragraph",{text="Use percentages or UDim values for fluid widths. Use Inset, gap, and parent padding for spacing."}),
			}),
			h("CollapsibleSection",{title="Progressive disclosure",defaultOpen=true}, {
				h("Paragraph",{text="The section measures its content and animates its clipped container. Its children keep their state while collapsed."}),
				h("Checkbox",{label="State survives collapsing"}),
			}),
			h("Section",{title="Stacked positioning"},h("Stack",{style={height=110}}, {
				h("Frame",{style={width="100%",height=100,background="$raised",backgroundTransparency=0,radius=8}}),
				h("Text",{text="Positioned content",style={position=UDim2.fromOffset(16,16),width=UDim.new(1,-32),height=28,font="$typography.medium"}}),
				h("Badge",{text="Layer 2",style={position=UDim2.fromOffset(16,58),zIndex=2}}),
			})),
		})
	end
	local function FeedbackPanel()
		local progress,setProgress=UI.useState(0.64); local modal,setModal=UI.useState(false)
		return h("Column",{style={gap=16}}, {
			h("Text",{text="Feedback &amp; overlays",style={textSize=24,font="$typography.bold"}}),
			h("Section",{title="Status and progress"}, {
				h("Row",{}, {h("StatusIndicator",{status="success",text="Operational"}),h("StatusIndicator",{status="warning",text="Attention"}),h("Badge",{text="v1.0"})}),
				h("ProgressBar",{label="Release preparation",value=progress}),
				h("Slider",{label="Preview progress",min=0,max=100,value=math.round(progress*100),onChange=function(n) setProgress(n/100) end}),
				h("LoadingIndicator",{text="Waiting for your next idea…"}),
			}),
			h("Section",{title="Notifications and dialogs"}, {
				h("Button",{text="Show notification",onClick=function() app:Notify({title="Everything is up to date",message="Your workspace settings have been saved.",status="success"}) end}),
				h("Button",{text="Open modal",onClick=function() setModal(true) end}),
				h("Button",{text="Confirm an action",variant="primary",onClick=function() app:Confirm({title="Publish this release?",message="This demo only shows a confirmation. It does not publish anything.",onResult=function(result)
				app:Notify({title=if result then "Confirmed" else "Cancelled",message="The dialog returned a boolean result."})
			end}) end}),
			}),
			h("Modal",{open=modal,onOpenChange=setModal,title="A focused moment"}, {
				h("Paragraph",{text="Modal focus is contained. Tab cycles through controls, Escape dismisses, and the previous selection is restored."}),
				h("TextInput",{label="A note",placeholder="Try keyboard focus…"}),
				h("Button",{text="Done",variant="primary",onClick=function() setModal(false) end}),
			}),
		})
	end
	local function Appearance()
		local theme,setTheme=UI.useState("Dark"); local reduced,setReduced=UI.useState(false); local json,setJson=UI.useState("")
		return h("Column",{style={gap=16}}, {
			h("Text",{text="Make it yours",style={textSize=24,font="$typography.bold"}}),
			h("Section",{title="Appearance"}, {
				h("SegmentedControl",{label="Color theme",options={"Dark","Light"},value=theme,onChange=function(value) setTheme(value); app:SetTheme(value) end}),
				h("Toggle",{label="Reduce motion",description="Complete active transitions and stop looping animations.",value=reduced,onChange=function(value) setReduced(value); app:SetReducedMotion(value) end}),
				h("Button",{text="Use selected highlight color",onClick=function() app.Theme:Extend({accent=settings.color:get()}) end}),
			}),
			h("Section",{title="Configuration",description="Profiles use optional filesystem capabilities or an in-memory fallback."}, {
				h("Row",{style={distribute="fill"}}, {
					h("Button",{text="Export JSON",onClick=function() local text,err=app.Config:Export(); if text then setJson(text) else app:Notify({title="Export failed",message=err,status="error"}) end end}),
					h("Button",{text="Import JSON",onClick=function() local ok,err=app.Config:Import(json); app:Notify({title=if ok then "Imported" else "Import failed",message=err or "Settings restored",status=if ok then "success" else "error"}) end}),
				}),
				h("TextInput",{label="Profile JSON",value=json,onChange=setJson,multiline=true}),
				h("Button",{text="Reset defaults",onClick=function() app.Config:Reset() end}),
			}),
		})
	end
	local function App()
		return h("Window",{id="gallery",title="MattLib  /  Component Studio",size={940,650},minSize=Vector2.new(300,260),openKey="RightShift"},
			h("Sidebar",{items={{id="overview",title="Overview",content=h(Overview)},{id="inputs",title="Inputs &amp; controls",content=h(Inputs)},
				{id="layout",title="Layout",content=h(Layouts)},{id="feedback",title="Feedback",content=h(FeedbackPanel)},{id="appearance",title="Appearance",content=h(Appearance)}}}))
	end
	local root=UI.mount(h(App))
	return {library=app,root=root,Destroy=function() app:Destroy(); for _,signal in settings do signal:Destroy() end end}
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Dashboard</string><ProtectedString name="Source">return function(Library)
	local app=Library.new({id="mattlib-dashboard"})
	local UI=app.UI; local h=UI.h
	local initial={{id=1,name="Design system audit",category="Design",done=true},{id=2,name="Validate native layouts",category="Engineering",done=false},
		{id=3,name="Prepare release notes",category="Release",done=false},{id=4,name="Review keyboard flows",category="Design",done=false}}
	local nextId=4
	local function TaskRow(p)
		local expanded,setExpanded=UI.useState(false)
		return h("Section",{style={padding=12,gap=8}}, {
			h("Checkbox",{label=p.task.name,description=p.task.category,value=p.task.done,onChange=function(value) p.onToggle(p.task.id,value) end}),
			h("Row",{style={distribute="fill"}}, {
				h("Button",{text=if expanded then "Hide details" else "Details",variant="ghost",onClick=function() setExpanded(not expanded) end}),
				h("Button",{text="Remove",variant="ghost",onClick=function() p.onRemove(p.task.id) end}),
			}),
			expanded and h("Paragraph",{text="Task #"..p.task.id.." keeps this local disclosure state when the keyed list is reordered."}) or false,
		})
	end
	local function Dashboard()
		local tasks,setTasks=UI.useState(initial); local filter,setFilter=UI.useState("All"); local search,setSearch=UI.useState("")
		local draft,setDraft=UI.useState(""); local inspector,setInspector=UI.useState(false)
		local visible=UI.useMemo(function()
			local result={}
			for _,task in tasks do if (filter=="All" or (filter=="Done")==task.done) and string.find(string.lower(task.name),string.lower(search),1,true) then table.insert(result,task) end end
			return result
		end,{tasks,filter,search})
		local done=0; for _,task in tasks do if task.done then done+=1 end end
		local function toggle(id,value)
			setTasks(function(previous) local result={}; for _,task in previous do local copy=table.clone(task); if copy.id==id then copy.done=value end; table.insert(result,copy) end; return result end)
		end
		local function remove(id)
			setTasks(function(previous) local result={}; for _,task in previous do if task.id~=id then table.insert(result,task) end end; return result end)
		end
		local function add()
			if not string.find(draft,"%S") then return end
			nextId+=1; local task={id=nextId,name=draft,category="Inbox",done=false}
			setTasks(function(previous) local result=table.clone(previous); table.insert(result,task); return result end); setDraft("")
		end
		return h(UI.Fragment,{}, {
			h("Window",{id="dashboard",title="Orbit  /  Release workspace",size={1000,680},openKey="F8"},
				h("Tabs",{items={{id="workspace",title="Workspace",content=h("Column",{style={gap=16}}, {
					h("Row",{}, {h("Text",{text="Release overview",style={width=UDim.new(1,-110),textSize=26,font="$typography.bold"}}),h("Badge",{text="SPRINT 08"})}),
					h("Paragraph",{text="A working application composed from reusable controls. Filter, reorder, create and remove keyed task components."}),
					h("Section",{title="Readiness",description=done.." of "..#tasks.." tasks complete"}, {
						h("ProgressBar",{value=if #tasks&gt;0 then done/#tasks else 0}),
						h("Row",{style={distribute="fill"}}, {
							h("Button",{text="Reverse order",onClick=function() setTasks(function(previous) local result={}; for i=#previous,1,-1 do table.insert(result,previous[i]) end; return result end) end}),
							h("Button",{text="Open inspector",onClick=function() setInspector(true) end}),
							h("Button",{text="Prepare release",variant="primary",onClick=function() app:Confirm({title="Prepare a release?",message="The demo records a local notification only.",onResult=function(result) if result then app:Notify({title="Release prepared",message="The local review is complete.",status="success"}) end end}) end}),
						}),
					}),
					h("Row",{style={distribute="fill"}}, {
						h("TextInput",{placeholder="Search tasks…",value=search,onChange=setSearch}),
						h("SegmentedControl",{options={"All","Open","Done"},value=filter,onChange=setFilter}),
					}),
					h("Row",{}, {h("TextInput",{style={width=UDim.new(1,-116)},placeholder="Add a task…",value=draft,onChange=setDraft,onCommit=function(_,enter) if enter then add() end end}),h("Button",{text="Add task",style={width=108},onClick=add})}),
					h("Column",{},UI.list(visible,function(task) return h(TaskRow,{task=task,onToggle=toggle,onRemove=remove}) end,function(task) return task.id end)),
					#visible==0 and h("Section",{title="Nothing here",description="Change the filter or add your first task."}) or false,
				})},{id="activity",title="Activity",content=h("Section",{title="Application lifecycle"}, {
					h("Paragraph",{text="Open the inspector to review current managed counts. This demo uses no background polling loops."}),
					h("StatusIndicator",{status="success",text="Native renderer connected"}),
					h("Keybind",{label="Workspace shortcut",defaultValue="F7",onTrigger=function() app:Notify({title="Workspace",message="Shortcut activated"}) end}),
				})}}})),
			inspector and h("Window",{key="inspector",id="inspector",title="Workspace inspector",size={360,350},position={40,70},openKey=false,onClose=function() setInspector(false) end},
				h("ScrollArea",{contentStyle={padding=16}}, {
					h("Section",{title="Current snapshot"},UI.list({"components","instances","connections","subscriptions","windows"},function(name)
					return h("Text",{text=name.."  ·  "..tostring(app:GetDiagnostics()[name])})
				end,function(name) return name end)),
					h("Paragraph",{text="Counts are a render-time snapshot. Closing this window releases its instances and connections."}),
				})) or false,
		})
	end
	local root=UI.mount(h(Dashboard))
	return {library=app,root=root,Destroy=function() app:Destroy() end}
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Basic</string><ProtectedString name="Source">-- ModuleScript: require this module and call the returned function with MattLib.
return function(Library)
	local app=Library.new({id="mattlib-basic"})
	local window=app:CreateWindow({Id="basic",Title="My Application",Size={620,460},OpenKey="RightShift"})
	local home=window:AddTab({Title="Home"})
	local settings=home:AddSection({Title="Settings",Description="Built with the same components as the declarative API."})
	settings:AddParagraph({Content="A small menu with real state, cleanup, and optional persistence."})
	local enabled=settings:AddToggle({Id="enabled",Title="Enable feature",Default=false,Callback=function(value) print("Enabled:",value) end})
	settings:AddSlider({Id="volume",Title="Volume",Min=0,Max=100,Step=1,Default=65})
	settings:AddButton({Title="Notify",Callback=function() app:Notify({title="Ready",message="Feature enabled: "..tostring(enabled:GetValue())}) end})
	settings:AddButton({Title="Save profile",Callback=function()
		local ok,result=app.Config:Save("default")
		app:Notify({title=if ok then "Saved" else "Save failed",message=tostring(result),status=if ok then "success" else "error"})
	end})
	settings:AddButton({Title="Load profile",Callback=function()
		local ok,result=app.Config:Load("default")
		app:Notify({title=if ok then "Loaded" else "Load failed",message=result and tostring(result) or "Settings restored",status=if ok then "success" else "error"})
	end})
	return {library=app,window=window,Destroy=function() app:Destroy() end}
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Declarative</string><ProtectedString name="Source">return function(Library)
	local app=Library.new({id="mattlib-declarative"})
	local UI=app.UI
	local function Counter()
		local count,setCount=UI.useState(0)
		UI.useEffect(function()
			print("Counter mounted")
			return function() print("Counter unmounted") end
		end,{})
		return UI.h("Section",{title="A functional component"}, {
			UI.h("Text",{text="Count: "..count}),
			UI.h("Button",{text="Increment",variant="primary",onClick=function() setCount(function(previous) return previous+1 end) end}),
			UI.when(count&gt;0,UI.h("Paragraph",{text="This conditional element is incrementally mounted."})),
		})
	end
	local function App()
		return UI.h("Window",{id="counter",title="Declarative Luau",size={620,440}}, {
			UI.h("Tabs",{}, {
				UI.h("Tab",{id="home",title="Home"}, {UI.h(Counter)}),
				UI.h("Tab",{id="about",title="About"}, {UI.h("Paragraph",{text="Native Roblox UI. Stable keys. Owned lifecycles."})}),
			}),
		})
	end
	local root=UI.mount(UI.h(App))
	return {library=app,root=root,Destroy=function() app:Destroy() end}
end
